{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "idp-provisioner",
  "main": "src/index.ts",
  "account_id": "07a2eb0d4916b220da1f9c1387b5f6d8",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  // Reached only through the main Worker's IDP service binding: no public route.
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": true,
  "vars": {
    "POCKET_ID_ORIGIN": "https://id.example.invalid",
    "POCKET_ID_API": "v2",
    "DEVELOPER_GROUP_ID": "",
    "DEVELOPER_GROUP_NAME": "passbook_developers",
    "PROTECTED_GROUP_NAMES": "wallet_admins,wallet_org_admins,wallet_users"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "idp-provisioner",
      // Placeholder until `wrangler d1 create idp-provisioner` (docs/operations.md, Polaris ID provisioner).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "secrets": { "required": ["POCKET_ID_API_KEY"] },
  "observability": { "enabled": true }
}
