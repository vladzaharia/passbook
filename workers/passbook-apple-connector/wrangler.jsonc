{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "passbook-apple-connector",
  "main": "src/index.ts",
  "account_id": "07a2eb0d4916b220da1f9c1387b5f6d8",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  // Reached only through the main Worker's APPLE service binding: no public route.
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "passbook-apple-connector",
      // Retired id of the old apple-provisioner database, do not reuse: 9159226c-8d6c-4458-ab15-1856ae7f6593
      // Placeholder until `wrangler d1 create passbook-apple-connector` (docs/operations.md, Apple provisioner).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "secrets": { "required": ["ASC_KEY_P8", "ASC_KEY_ID", "ASC_ISSUER_ID"] },
  "observability": { "enabled": true }
}
