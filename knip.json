{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/web/routes/**/*.{ts,tsx}!",
    "src/web/scan/main.tsx!",
    "src/web/scan/camera/decode-worker.ts!",
    "tools/*.ts",
    "e2e/**/*.ts",
    "test/**/*.ts",
    "*.config.ts"
  ],
  "project": ["src/**/*.{ts,tsx}!", "tools/**/*.ts", "e2e/**/*.ts", "test/**/*.ts"],
  "ignore": [],
  "ignoreDependencies": ["@polaris-key/brand", "cloudflare", "tailwindcss"],
  "ignoreBinaries": ["openssl"],
  "rules": {
    "nsExports": "off",
    "nsTypes": "off",
    "duplicates": "off",
    "enumMembers": "off"
  },
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "src/passkit/**": ["exports", "types"],
    "src/worker/modules/scan/**": ["exports", "types"],
    "src/web/scan/{machine/types,timing,input/types}.ts": ["exports", "types"],
    "src/web/scan/offline/{db,unsure-store,wipe}.ts": ["exports"],
    "src/web/scan/sound/player.ts": ["exports"],
    "src/shared/**": ["exports", "types"],
    "src/web/scan/{boot/admin-scope,ui/scan-menu}.tsx": ["files", "exports", "types"],
    "src/web/scan/ui/{capsule,chips}.tsx": ["exports", "types"],
    "tools/lib/**": ["exports"],
    "src/web/ui/{dropdown-menu,dialog,sheet,popover}.tsx": ["exports"],
    "src/web/ui/art/index.ts": ["types"],
    "src/web/pass-card/index.tsx": ["types"],
    "src/web/admin/passes/schema-form/index.ts": ["types"]
  }
}
