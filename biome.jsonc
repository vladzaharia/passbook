{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.wrangler",
      "!**/dist",
      "!**/coverage",
      "!docs/api/openapi.v1.json",
      "!docs/api/errors.json",
      "!docs/api/operation-codes.json",
      "!docs/api/webhook-events.json",
      "!docs/api/webhook-vectors.json",
      "!**/playwright-report",
      "!**/test-results",
      "!src/generated",
      "!sdk/typescript/src/generated",
      "!sdk/typescript/dist",
      "!sdk/python/tests/ops.json",
      "!test/setup/schema-snapshot.generated.json",
      "!src/web/routeTree.gen.ts",
      "!worker-configuration.d.ts",
      "!docs/research",
      "!docs/developers/snippets",
      "!docs/audits",
      "!docs/design/scanner/buddy-draft",
      "!templates",
      "!public/templates",
      "!public/fonts",
      "!public/pass-tilt.js",
      "!public/apple",
      "!public/*.svg",
      "!package-lock.json",
      "!migrations/*.sql"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "markdown": { "formatter": { "enabled": false } },
  "yaml": { "formatter": { "enabled": false } },
  "json": { "formatter": { "trailingCommas": "none" }, "parser": { "allowComments": true } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": { "useImportType": "error", "noNonNullAssertion": "warn" },
      "suspicious": { "noExplicitAny": "error", "noConsole": "error", "noImportCycles": "error" },
      "correctness": { "noUnusedImports": "error", "noUnusedVariables": "error" },
      "nursery": { "noFloatingPromises": "error", "noMisusedPromises": "error" }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "complexity": { "noImportantStyles": "off" },
          "style": { "noDescendingSpecificity": "off" }
        }
      }
    },
    {
      "includes": [
        "tools/**",
        "e2e/**",
        "test/mock-oidc/**",
        "*.config.ts",
        "sdk/typescript/examples/**"
      ],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    },
    // The Playwright rules also match vitest describe(name, opts, fn), jest-dom matchers and any
    // function named describe; they apply to e2e/** only.
    {
      "includes": ["src/**", "test/**"],
      "linter": {
        "rules": {
          "correctness": {
            "usePlaywrightValidDescribeCallback": "off",
            "noPlaywrightMissingAwait": "off"
          }
        }
      }
    },
    // Harnesses and wrappers in tests mount once per test; no parent re-renders them.
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*test-fixtures.ts",
        "**/*test-fixtures.tsx"
      ],
      "linter": { "rules": { "correctness": { "noComponentHookFactories": "off" } } }
    },
    // The NTAG 424 simulator signs with a test key and hands out factory-blank tags: only tests may import it.
    {
      "includes": [
        "src/**",
        "!**/*.test.ts",
        "!src/worker/modules/nfc/ntag424/sim/**",
        "!**/*test-fixtures.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/ntag424/sim/**", "./sim/**"],
                    "message": "The NTAG 424 simulator is test-only."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "test/**"],
      "linter": {
        "rules": {
          "style": { "noNonNullAssertion": "off" },
          "suspicious": { "noExplicitAny": "off" }
        }
      }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
