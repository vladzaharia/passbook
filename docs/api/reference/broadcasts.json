{
  "broadcasts.postBroadcastsByIdUndo": {
    "description": "Undoes a change run for 24 hours after it ends, as a silent background run. Each pass gets back the inputs the change touched, but only while they still hold the value the change set: a pass edited since keeps its edit, and any other input it holds. Nothing notifies. Asking again returns the same undo; one that ended on an error runs again. A run that is still sending must be stopped first. Read the result from GET /broadcasts/{id} on the returned `id`.",
    "response": {
      "id": "0193a1b2-7c00-7000-8000-000000000042",
      "parentId": "0193a1b2-7c00-7000-8000-3ce3679141b7",
      "restorable": 27,
      "kept": 14
    }
  },
