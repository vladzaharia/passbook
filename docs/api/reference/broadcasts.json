  "broadcasts.postBroadcastsPreview": {
    "description": "Counts the passes a target matches. With `patch` (and `notify`) it also previews a change: up to 20 sample passes with their field changes, passes already at the new values, passes it cannot change by reason, and how many holders would be told. Samples show each pass's own values, so a key needs passes:read. Counts and samples come from the 200 newest passes of the target and who is told is an estimate (`estimated`). It is the dry run of a change: it takes the same `target` and `patch` as `POST /broadcasts` and changes nothing. An input the template lacks gives empty `changes`; the run refuses it. Over 20,000 passes is 422 `MATCH_TOO_BROAD`.",
    "request": {
      "orgId": "0193a1b2-7c00-7000-8000-0000000000a1",
      "target": {
        "templateIds": ["0193a1b2-7c00-7000-8000-0000000000b1"],
        "onDevice": false
      },
      "patch": {
        "healthy": {}
      },
      "notify": false,
      "message": "The gym closes at 18:00 on 24 December."
    },
    "response": {
      "targeted": 16,
      "onDevice": 11,
      "overBudget": 39,
      "limit": 25,
      "samples": [
        {
          "passId": "0193a1b2-7c00-7000-8000-0000000000c1",
          "title": "Holiday hours",
          "changes": [
            {
              "key": "tier",
              "label": "Holiday hours",
              "from": "hello@example.com",
              "to": "ada@example.com"
            }
          ]
        }
      ],
      "unchanged": 11,
      "blocked": [
        {
          "code": "NW7K2Q",
          "count": 12
        }
      ],
      "notified": 17,
      "silent": 6,
      "estimated": false
    }
  },
  "broadcasts.postBroadcasts": {
    "description": "Saves, sends or schedules a message or a change run. A change sets inputs on many passes: one target (`templateIds` with filters, `passIds` up to 5,000, or the `importId` of an ended import), `patch` operations (`set`, `clear`, `shift`, `add`, or `$void` or `$design` alone) and an optional `message` for the lock screen (needs `notify`). `target.expectCount` is the count a preview showed: when the server's count differs by more than 2% the run does not start and the answer is 409 `SELECTION_CHANGED`. More than 20,000 passes is 422 `MATCH_TOO_BROAD`. A target key it does not define is 422 `BROADCAST_UNSUPPORTED_FILTER`, never ignored. Needs `messages:write` and, for a change, `passes:write`. Send an `Idempotency-Key`; the same key and body returns the same run.",
    "request": {
      "orgId": "0193a1b2-7c00-7000-8000-0000000000a1",
      "kind": "message",
      "name": "Holiday hours",
      "notify": false,
      "send": "now",
