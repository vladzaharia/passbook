  "passes.postPassesBulkRuns": {
    "description": "Voids, emails or removes every pass a filter matches, in the background. The matching passes are fixed when the run starts; `expectCount` must equal the count then, or it answers 409 `SELECTION_CHANGED`. One run at a time per organization and mode.",
    "request": {
      "action": "void",
      "selection": {
        "filter": {
          "status": "active"
        },
        "expectCount": 442
      }
    },
    "response": {
      "id": "0193a1b2-7c00-7000-8000-0000000000e1",
