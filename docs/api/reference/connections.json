{
  "connections.postConnectionsByIdPreview": {
    "description": "A dry run of the next sync over the last 30 days of records, at most 200: what it would create, update, leave unchanged, skip or reject. New records wait (`counts.waiting`) while the template has no approved release (`releaseBlocked`). It reads the source and the connection's passes and writes nothing: no cursor moves and no run is recorded. `columns` lists the source's fields with up to three sample cells and, for a field with few distinct values, those values and their counts. Needs connections:read and passes:read.",
    "response": {
      "ok": true,
      "records": 3,
      "counts": {
        "create": 3,
        "update": 3,
        "unchanged": 3,
        "skipped": 3,
        "errors": 0,
        "waiting": 3
      },
      "releaseBlocked": "no_release",
      "window": {
        "days": 3,
        "limit": 25,
        "since": 3,
        "excluded": 3
      },
      "samples": [
        {
          "ref": "booking_8841",
          "action": "create",
          "fields": {
            "tier": {}
          },
          "message": "The gym closes at 18:00 on 24 December."
        }
      ],
      "columns": [
        {
          "pointer": "/input/tier",
          "label": "Booking sheet",
          "samples": ["Day pass"],
          "values": [
            {
              "value": "Day pass",
              "count": 12
            }
          ]
        }
      ],
      "durationMs": 3
    }
  },
