          "action": "update",
          "fields": {
            "validUntil": "2027-01-31"
          }
        }
      ],
      "columns": [
        {
          "pointer": "/Booking ID",
          "label": "Booking ID",
          "samples": ["B-2041", "B-2038"],
          "values": []
        },
        {
          "pointer": "/Plan",
