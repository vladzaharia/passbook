      "ok": true,
      "records": 3,
      "counts": {
        "create": 1,
        "update": 1,
        "unchanged": 1,
        "skipped": 0,
        "errors": 0,
        "waiting": 0
      },
      "releaseBlocked": null,
      "window": {
        "days": 30,
        "limit": 200,
        "since": 1792980000000,
        "excluded": 0
      },
      "samples": [
        {
          "ref": "B-2041",
          "action": "create",
          "fields": {
            "name": "Mei Tanaka",
            "tier": "Day pass"
          }
        },
        {
