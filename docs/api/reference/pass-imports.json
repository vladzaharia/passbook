  "pass-imports.postPassImportsByIdCommit": {
    "description": "Creates the new passes and updates the matched ones, in the background; read the import until `state` is `done`. `skipInvalid` skips error rows instead of refusing the commit. `email` is off by default: `true` sends at once, `{ \"send\": \"held\", \"holdMs\": 300000 }` holds the mail for 1 to 60 minutes so an undo cancels it. Another commit of the same template meanwhile is 409 `IMPORT_BUSY`. Send an `Idempotency-Key`.",
    "request": {
      "skipInvalid": false,
      "email": {
        "send": "held",
        "holdMs": 300000
      }
    },
    "response": {
      "id": "0193a1b2-7c00-7000-8000-0000000000e1",
      "templateId": "0193a1b2-7c00-7000-8000-0000000000b1",
