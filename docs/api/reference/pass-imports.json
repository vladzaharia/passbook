      "mode": "test",
      "state": "committing",
      "source": {
        "kind": "file",
        "name": "guests.csv"
      },
      "columns": [],
      "plan": {
        "mapping": {
          "eventName": {
            "from": "/Event"
          },
          "venueName": {
            "from": "/Venue"
          },
          "venueRegion": {
            "from": "/City"
          },
          "startsAt": {
            "from": "/Starts",
            "transform": {
              "kind": "date",
              "options": {
                "input": "iso",
                "output": "iso"
              }
            }
          },
          "endsAt": {
