  "pass-imports.postPassImportsByIdUndo": {
    "description": "Undoes an ended import for 24 hours after it ends, as a background run. Passes it created are removed unless they were edited or scanned since. Passes it updated get their earlier values back while still at the version the import wrote. Anything else is kept and listed in `kept`. Held emails are canceled; emails already sent are not recalled. Asking again returns the same run. Poll GET /pass-imports/{id} for `undo`.",
    "request": {},
    "response": {
      "state": "done",
      "removed": 1,
      "restored": 1,
      "keptTotal": 1,
      "kept": [
        {
          "passId": "0193a1b2-7c00-7000-8000-0000000000c1",
          "code": "IMPORT_PASS_SCANNED"
        }
      ],
      "emailsCancelled": 0,
      "unrevertable": 0
    }
  },
  "pass-imports.postPassImports": {
    "description": "Starts an import from a CSV sent as text or from an https link. With `mapping: \"auto\"` and no `plan`, the server maps the headers from the template (or from a saved mapping that shares 80% of them) and checks the file in the same call: `state` is `ready` with `counts` and `problems`. When no plan fits, `state` stays `mapping`, `plan` is null and `mapping.missing` names the required fields without a column. With a `plan` it checks that plan. Send an `Idempotency-Key` to make a retry return the same import. Next: check, then commit.",
