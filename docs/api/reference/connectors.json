  "connectors.getConnectorsWebhookPushRecipesByRecipeSetup": {
    "description": "A sender's webhook setup guide: steps, topics, where the secret comes from and fix lines.",
    "response": {
      "direction": "inbound",
      "recipe": "shopify-customers",
      "version": "2026-11-25",
      "checkedAt": "2026-11-25",
      "provider": {
        "name": "Shopify",
        "consoleUrl": null,
        "docs": [
          {
            "label": "Shopify: webhooks",
            "url": "https://help.shopify.com/en/manual/orders/notifications/webhooks"
          }
        ]
      },
      "secret": {
        "origin": "provider",
        "allowPaste": true,
        "prefix": null,
        "minLength": 16,
        "whereStep": "secret"
      },
      "subscriptions": {
        "perWebhook": "one",
        "topics": [
          {
            "id": "customers/create",
            "label": "Customer creation",
            "required": true,
            "verified": true
          },
          {
            "id": "customers/update",
            "label": null,
            "required": true,
            "verified": false
          }
        ]
      },
      "steps": [
        {
          "id": "connect",
          "side": "provider",
          "title": "Add the webhooks",
          "parts": [
            {
              "t": "path",
              "items": ["Settings", "Notifications", "Webhooks", "Create webhook"]
            },
            {
              "t": "field",
              "label": "Format",
              "value": "JSON",
              "choose": false
            },
            {
              "t": "field",
              "label": "URL",
              "copy": "endpointUrl",
              "choose": false
            },
            {
              "t": "topics"
            }
          ],
          "verified": true
        },
        {
          "id": "secret",
          "side": "provider",
          "title": "Copy the signing secret",
          "parts": [
            {
              "t": "text",
              "text": "Shopify signs every webhook made in admin with one secret for the store."
            }
          ],
          "verified": false
        }
      ],
      "test": {
        "kind": "button",
        "text": "Row menu, **Send test**. The sample may not be a real record, so no pass is issued.",
        "command": null,
        "issues": false
      },
      "troubleshooting": {
        "none": "Check the webhook is listed. Shopify deletes one that keeps failing.",
        "signature_mismatch": "The secret isn't the one signing these. Copy it again."
      }
