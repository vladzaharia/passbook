  "webhooks.postWebhookEndpointsCapture": {
    "description": "Returns the capture endpoint of your sandbox, making it if there is none. A capture endpoint stores the signed requests PassBook would send, so you can read and verify them; it sends nothing and takes nothing from outside. Sandbox orgs in Test mode only. The signing `secret` is shown once, on creation; later calls return `secret: null`.",
    "request": {
      "eventTypes": ["pass.issued", "pass.updated"]
    },
    "response": {
      "endpoint": {
        "id": "0193a1b2-7c00-7000-8000-0000000000f2",
