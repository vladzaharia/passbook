{
  "schema": 1,
  "name": "PassBook · Store card",
  "description": "Stored-value card with balance, strip image, relevance and two featured actions.",
  "inputs": {
    "type": "object",
    "required": [
      "holder",
      "cardNumber"
    ],
    "additionalProperties": false,
    "properties": {
      "holder": {
        "type": "string",
        "x-label": "Name",
        "x-group": "Holder",
        "x-order": 10,
        "minLength": 1,
        "maxLength": 80,
        "x-search": true
      },
      "cardNumber": {
        "type": "string",
        "x-label": "Card number",
        "x-group": "Holder",
        "x-order": 20,
        "minLength": 1,
        "maxLength": 64,
        "x-search": true
      },
      "tier": {
        "type": "string",
        "x-label": "Tier",
        "x-group": "Holder",
        "x-order": 30,
        "enum": [
          "Standard",
          "Gold"
        ],
        "default": "Standard",
        "x-widget": "select"
      },
      "balance": {
        "type": "number",
        "minimum": 0,
        "maximum": 1000000,
        "default": 0,
        "x-label": "Balance",
        "x-group": "Balance",
        "x-order": 40
      },
      "currency": {
        "type": "string",
        "x-label": "Currency",
        "x-group": "Balance",
        "x-order": 50,
        "enum": [
          "USD",
          "EUR",
          "GBP"
        ],
        "default": "USD",
        "x-widget": "select"
      },
      "note": {
        "type": "string",
        "x-label": "Note",
        "x-group": "Message",
        "x-order": 60,
        "maxLength": 256,
        "x-widget": "textarea"
      },
      "website": {
        "type": "string",
        "x-label": "Website",
        "x-group": "Links",
        "x-order": 70,
        "format": "uri",
        "pattern": "^https://",
        "maxLength": 300,
        "x-widget": "url",
        "x-placeholder": "https://"
      },
      "storeLat": {
        "type": "number",
        "minimum": -90,
        "maximum": 90,
        "x-label": "Store latitude",
        "x-group": "Location",
        "x-order": 200
      },
      "storeLng": {
        "type": "number",
        "minimum": -180,
        "maximum": 180,
        "x-label": "Store longitude",
        "x-group": "Location",
        "x-order": 201
      },
      "shopURL": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://",
        "maxLength": 300,
        "x-label": "Shop link",
        "x-group": "Links",
        "x-order": 75,
        "x-widget": "url"
      }
    },
    "dependentRequired": {
      "storeLat": [
        "storeLng"
      ],
      "storeLng": [
        "storeLat"
      ]
    }
  },
  "sample": {
    "holder": "Alex Morgan",
    "cardNumber": "CARD-0001",
    "tier": "Gold",
    "balance": 25,
    "currency": "USD"
  },
  "bindings": [
    {
      "to": {
        "field": "holder"
      },
      "value": "{{holder}}"
    },
    {
      "to": {
        "field": "tier"
      },
      "value": "{{tier}}"
    },
    {
      "to": {
        "field": "balance"
      },
      "value": "{{balance}}"
    },
    {
      "to": {
        "field": "balance",
        "prop": "currencyCode"
      },
      "value": "{{currency}}"
    },
    {
      "to": {
        "field": "note"
      },
      "value": "{{note}}",
      "remove": {
        "input": "note",
        "empty": true
      }
    },
    {
      "to": {
        "field": "site"
      },
      "value": "{{website}}",
      "omitIfEmpty": true
    },
    {
      "to": {
        "field": "site",
        "prop": "attributedValue"
      },
      "value": "<a href=\"{{website|html}}\">{{website|html}}</a>",
      "omitIfEmpty": true
    },
    {
      "to": {
        "barcode": "*",
        "prop": "message"
      },
      "value": "{{cardNumber}}"
    },
    {
      "to": {
        "barcode": "*",
        "prop": "altText"
      },
      "value": "{{cardNumber}}"
    },
    {
      "to": {
        "action": "top-up",
        "prop": "url"
      },
      "value": "{{website}}",
      "omitIfEmpty": true
    },
    {
      "to": {
        "action": "shop",
        "prop": "url"
      },
      "value": "{{shopURL}}",
      "omitIfEmpty": true
    },
    {
      "to": {
        "pointer": "/semantics/balance/amount"
      },
      "value": "{{balance|str}}"
    },
    {
      "to": {
        "pointer": "/semantics/balance/currencyCode"
      },
      "value": "{{currency}}"
    },
    {
      "to": {
        "pointer": "/locations/0/latitude"
      },
      "value": "{{storeLat}}"
    },
    {
      "to": {
        "pointer": "/locations/0/longitude"
      },
      "value": "{{storeLng}}"
    },
    {
      "to": {
        "pointer": "/locations"
      },
      "remove": {
        "any": [
          {
            "input": "storeLat",
            "empty": true
          },
          {
            "input": "storeLng",
            "empty": true
          }
        ]
      }
    }
  ],
  "display": {
    "title": "{{holder}}",
    "subtitle": "{{tier}} · {{cardNumber}}",
    "status": "{{tier}}",
    "search": [
      "holder",
      "cardNumber"
    ]
  }
}
