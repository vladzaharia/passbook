{
  "schema": 1,
  "name": "PassBook · Boarding pass",
  "description": "Air boarding pass with the semantic layout and a classic fallback.",
  "inputs": {
    "type": "object",
    "required": [
      "passengerGiven",
      "passengerFamily",
      "airlineCode",
      "flightNumber",
      "origin",
      "originCity",
      "originTimeZone",
      "destination",
      "destinationCity",
      "destinationTimeZone",
      "boardsAt",
      "departsAt",
      "arrivesAt",
      "ticketId"
    ],
    "additionalProperties": false,
    "properties": {
      "passengerGiven": {
        "type": "string",
        "x-label": "First name",
        "x-group": "Passenger",
        "x-order": 10,
        "minLength": 1,
        "maxLength": 40
      },
      "passengerFamily": {
        "type": "string",
        "x-label": "Last name",
        "x-group": "Passenger",
        "x-order": 20,
        "minLength": 1,
        "maxLength": 40,
        "x-search": true
      },
      "airlineCode": {
        "type": "string",
        "x-label": "Carrier code",
        "x-group": "Flight",
        "x-order": 30,
        "minLength": 2,
        "maxLength": 3,
        "x-search": true
      },
      "flightNumber": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9999,
        "x-label": "Service number",
        "x-group": "Flight",
        "x-order": 40
      },
      "origin": {
        "type": "string",
        "x-label": "Origin code",
        "x-group": "Route",
        "x-order": 50,
        "minLength": 3,
        "maxLength": 3,
        "pattern": "^[A-Z]{3}$",
        "x-help": "IATA code"
      },
      "originCity": {
        "type": "string",
        "x-label": "From city",
        "x-group": "Route",
        "x-order": 60,
        "minLength": 1,
        "maxLength": 60
      },
      "originTimeZone": {
        "type": "string",
        "x-label": "From time zone",
        "x-group": "Route",
        "x-order": 70,
        "minLength": 1,
        "maxLength": 40,
        "x-help": "IANA name"
      },
      "destination": {
        "type": "string",
        "x-label": "Destination code",
        "x-group": "Route",
        "x-order": 80,
        "minLength": 3,
        "maxLength": 3,
        "pattern": "^[A-Z]{3}$",
        "x-help": "IATA code"
      },
      "destinationCity": {
        "type": "string",
        "x-label": "To city",
        "x-group": "Route",
        "x-order": 90,
        "minLength": 1,
        "maxLength": 60
      },
      "destinationTimeZone": {
        "type": "string",
        "x-label": "To time zone",
        "x-group": "Route",
        "x-order": 100,
        "minLength": 1,
        "maxLength": 40,
        "x-help": "IANA name"
      },
      "boardsAt": {
        "type": "string",
        "x-label": "Boarding",
        "x-group": "Times",
        "x-order": 110,
        "format": "date-time",
        "x-widget": "datetime"
      },
      "departsAt": {
        "type": "string",
        "x-label": "Departure",
        "x-group": "Times",
        "x-order": 120,
        "format": "date-time",
        "x-widget": "datetime"
      },
      "arrivesAt": {
        "type": "string",
        "x-label": "Arrival",
        "x-group": "Times",
        "x-order": 130,
        "format": "date-time",
        "x-widget": "datetime"
      },
      "gate": {
        "type": "string",
        "x-label": "Gate",
        "x-group": "Seat",
        "x-order": 140,
        "maxLength": 8
      },
      "seat": {
        "type": "string",
        "x-label": "Seat",
        "x-group": "Seat",
        "x-order": 150,
        "maxLength": 8
      },
      "transitType": {
        "type": "string",
        "x-label": "Transit",
        "x-group": "Flight",
        "x-order": 35,
        "enum": [
          "air",
          "train",
          "bus",
          "boat",
          "generic"
        ],
        "default": "air",
        "x-widget": "select"
      },
      "ticketId": {
        "type": "string",
        "x-label": "Barcode",
        "x-group": "Seat",
        "x-order": 160,
        "minLength": 1,
        "maxLength": 120,
        "x-search": true
      },
      "note": {
        "type": "string",
        "x-label": "Note",
        "x-group": "Message",
        "x-order": 170,
        "maxLength": 256,
        "x-widget": "textarea"
      },
      "boardingGroup": {
        "type": "string",
        "maxLength": 8,
        "x-label": "Boarding group",
        "x-group": "Seat",
        "x-order": 155
      },
      "managementURL": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://",
        "maxLength": 300,
        "x-label": "Manage booking link",
        "x-group": "Links",
        "x-order": 170,
        "x-widget": "url"
      },
      "changeSeatURL": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://",
        "maxLength": 300,
        "x-label": "Change seat link",
        "x-group": "Links",
        "x-order": 180,
        "x-widget": "url"
      }
    }
  },
  "sample": {
    "passengerGiven": "Alex",
    "passengerFamily": "Morgan",
    "airlineCode": "WA",
    "flightNumber": 100,
    "origin": "SFO",
    "originCity": "San Francisco",
    "originTimeZone": "America/Los_Angeles",
    "destination": "JFK",
    "destinationCity": "New York",
    "destinationTimeZone": "America/New_York",
    "boardsAt": "2030-06-01T07:15:00-07:00",
    "departsAt": "2030-06-01T08:00:00-07:00",
    "arrivesAt": "2030-06-01T16:30:00-04:00",
    "gate": "B12",
    "seat": "14A",
    "ticketId": "BOARD-0001"
  },
  "lookups": {
    "transit": {
      "air": {
        "type": "PKTransitTypeAir",
        "label": "Flight"
      },
      "train": {
        "type": "PKTransitTypeTrain",
        "label": "Train"
      },
      "bus": {
        "type": "PKTransitTypeBus",
        "label": "Bus"
      },
      "boat": {
        "type": "PKTransitTypeBoat",
        "label": "Service"
      },
      "generic": {
        "type": "PKTransitTypeGeneric",
        "label": "Service"
      }
    }
  },
  "bindings": [
    {
      "to": {
        "pointer": "/boardingPass/transitType"
      },
      "value": "{{lookups.transit[transitType].type}}"
    },
    {
      "to": {
        "field": "flight"
      },
      "value": "{{airlineCode}}{{flightNumber}}"
    },
    {
      "to": {
        "field": "gate"
      },
      "value": "{{gate}}",
      "omitIfEmpty": true
    },
    {
      "to": {
        "field": "origin"
      },
      "value": "{{origin}}"
    },
    {
      "to": {
        "field": "origin",
        "prop": "label"
      },
      "value": "{{originCity}}"
    },
    {
      "to": {
        "field": "destination"
      },
      "value": "{{destination}}"
    },
    {
      "to": {
        "field": "destination",
        "prop": "label"
      },
      "value": "{{destinationCity}}"
    },
    {
      "to": {
        "field": "passenger"
      },
      "value": "{{passengerGiven}} {{passengerFamily}}"
    },
    {
      "to": {
        "field": "departs"
      },
      "value": "{{departsAt}}"
    },
    {
      "to": {
        "field": "boardsAt"
      },
      "value": "{{boardsAt}}"
    },
    {
      "to": {
        "field": "seat"
      },
      "value": "{{seat}}",
      "omitIfEmpty": true
    },
    {
      "to": {
        "field": "note"
      },
      "value": "{{note}}",
      "remove": {
        "input": "note",
        "empty": true
      }
    },
    {
      "to": {
        "barcode": "*",
        "prop": "message"
      },
      "value": "{{ticketId}}"
    },
    {
      "to": {
        "barcode": "*",
        "prop": "altText"
      },
      "value": "{{ticketId}}"
    },
    {
      "to": {
        "pointer": "/semantics/airlineCode"
      },
      "value": "{{airlineCode}}",
      "remove": {
        "not": {
          "input": "transitType",
          "eq": "air"
        }
      }
    },
    {
      "to": {
        "pointer": "/semantics/flightNumber"
      },
      "value": "{{flightNumber}}",
      "remove": {
        "not": {
          "input": "transitType",
          "eq": "air"
        }
      }
    },
    {
      "to": {
        "pointer": "/semantics/departureAirportCode"
      },
      "value": "{{origin}}",
      "remove": {
        "not": {
          "input": "transitType",
          "eq": "air"
        }
      }
    },
    {
      "to": {
        "pointer": "/semantics/departureCityName"
      },
      "value": "{{originCity}}"
    },
    {
      "to": {
        "pointer": "/semantics/departureLocationTimeZone"
      },
      "value": "{{originTimeZone}}"
    },
    {
      "to": {
        "pointer": "/semantics/destinationAirportCode"
      },
      "value": "{{destination}}",
      "remove": {
        "not": {
          "input": "transitType",
          "eq": "air"
        }
      }
    },
    {
      "to": {
        "pointer": "/semantics/destinationCityName"
      },
      "value": "{{destinationCity}}"
    },
    {
      "to": {
        "pointer": "/semantics/destinationLocationTimeZone"
      },
      "value": "{{destinationTimeZone}}"
    },
    {
      "to": {
        "pointer": "/semantics/originalBoardingDate"
      },
      "value": "{{boardsAt}}"
    },
    {
      "to": {
        "pointer": "/semantics/originalDepartureDate"
      },
      "value": "{{departsAt}}"
    },
    {
      "to": {
        "pointer": "/semantics/originalArrivalDate"
      },
      "value": "{{arrivesAt}}"
    },
    {
      "to": {
        "pointer": "/semantics/passengerName/givenName"
      },
      "value": "{{passengerGiven}}"
    },
    {
      "to": {
        "pointer": "/semantics/passengerName/familyName"
      },
      "value": "{{passengerFamily}}"
    },
    {
      "to": {
        "pointer": "/expirationDate"
      },
      "value": "{{arrivesAt}}"
    },
    {
      "to": {
        "pointer": "/preferredStyleSchemes"
      },
      "remove": {
        "not": {
          "input": "transitType",
          "eq": "air"
        }
      }
    },
    {
      "to": {
        "field": "flight",
        "prop": "label"
      },
      "value": "{{lookups.transit[transitType].label}}"
    },
    {
      "to": {
        "pointer": "/semantics/departureStationName"
      },
      "value": "{{originCity}}",
      "when": {
        "not": {
          "input": "transitType",
          "eq": "air"
        }
      }
    },
    {
      "to": {
        "pointer": "/semantics/destinationStationName"
      },
      "value": "{{destinationCity}}",
      "when": {
        "not": {
          "input": "transitType",
          "eq": "air"
        }
      }
    },
    {
      "to": {
        "pointer": "/semantics/transitProvider"
      },
      "value": "{{airlineCode}}",
      "when": {
        "not": {
          "input": "transitType",
          "eq": "air"
        }
      }
    },
    {
      "to": {
        "pointer": "/semantics/vehicleNumber"
      },
      "value": "{{airlineCode}}{{flightNumber}}",
      "when": {
        "not": {
          "input": "transitType",
          "eq": "air"
        }
      }
    },
    {
      "to": {
        "pointer": "/semantics/departureGate"
      },
      "value": "{{gate}}",
      "omitIfEmpty": true
    },
    {
      "to": {
        "pointer": "/semantics/boardingGroup"
      },
      "value": "{{boardingGroup}}",
      "omitIfEmpty": true
    },
    {
      "to": {
        "pointer": "/semantics/seats/0/seatNumber"
      },
      "value": "{{seat}}"
    },
    {
      "to": {
        "pointer": "/semantics/seats"
      },
      "remove": {
        "input": "seat",
        "empty": true
      }
    },
    {
      "to": {
        "pointer": "/managementURL"
      },
      "value": "{{managementURL}}",
      "omitIfEmpty": true
    },
    {
      "to": {
        "pointer": "/changeSeatURL"
      },
      "value": "{{changeSeatURL}}",
      "omitIfEmpty": true
    }
  ],
  "display": {
    "title": "{{passengerGiven}} {{passengerFamily}}",
    "subtitle": "{{origin}} to {{destination}}",
    "status": "{{airlineCode}}{{flightNumber}}",
    "search": [
      "passengerFamily",
      "airlineCode",
      "ticketId"
    ]
  },
  "behaviors": [
    {
      "use": "relevance-window",
      "version": 1,
      "config": {
        "start": "boardsAt",
        "end": "arrivesAt",
        "leadMinutes": 60
      }
    }
  ]
}
