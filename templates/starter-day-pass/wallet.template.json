{
  "schema": 1,
  "name": "Day pass",
  "description": "One day of entry, ending at midnight. Unlimited visits until then.",
  "wallets": {
    "schema": 1,
    "google": {},
    "samsung": {}
  },
  "channels": {
    "paper": "on",
    "nfc": "on"
  },
  "blueprint": true,
  "inputs": {
    "type": "object",
    "required": [
      "memberName",
      "memberId"
    ],
    "additionalProperties": false,
    "properties": {
      "memberName": {
        "type": "string",
        "x-label": "Name",
        "x-group": "Pass",
        "x-order": 10,
        "minLength": 1,
        "maxLength": 80,
        "x-search": true
      },
      "memberId": {
        "type": "string",
        "x-label": "Pass ID",
        "x-group": "Pass",
        "x-order": 20,
        "minLength": 1,
        "maxLength": 64,
        "x-search": true
      },
      "status": {
        "type": "string",
        "x-label": "Status",
        "x-group": "Status",
        "x-order": 30,
        "enum": [
          "Active",
          "Suspended"
        ],
        "default": "Active",
        "x-widget": "select"
      },
      "plan": {
        "type": "string",
        "x-label": "Plan",
        "x-group": "Pass",
        "enum": [
          "day"
        ],
        "default": "day",
        "x-widget": "select",
        "x-enumLabels": {
          "day": "Day pass"
        },
        "x-order": 40
      },
      "message": {
        "type": "string",
        "x-label": "Message",
        "x-group": "Message",
        "x-order": 50,
        "maxLength": 256,
        "x-widget": "textarea",
        "x-help": "Shown on the back."
      },
      "note": {
        "type": "string",
        "x-label": "Note",
        "x-group": "Message",
        "x-order": 60,
        "maxLength": 256,
        "x-widget": "textarea"
      }
    }
  },
  "sample": {
    "memberName": "Sam Reed",
    "memberId": "DAY-0001",
    "status": "Active",
    "plan": "day"
  },
  "bindings": [
    {
      "to": {
        "field": "holder"
      },
      "value": "{{memberName}}"
    },
    {
      "to": {
        "field": "member"
      },
      "value": "{{memberId}}"
    },
    {
      "to": {
        "field": "message"
      },
      "value": "{{message}}"
    },
    {
      "to": {
        "field": "note"
      },
      "value": "{{note}}",
      "remove": {
        "input": "note",
        "empty": true
      }
    },
    {
      "to": {
        "barcode": "*",
        "prop": "message"
      },
      "value": "{{pass.scanCode}}"
    },
    {
      "to": {
        "barcode": "*",
        "prop": "altText"
      },
      "value": "{{memberId}}"
    }
  ],
  "display": {
    "icon": "ticket",
    "group": "get-in",
    "aliases": [
      "day pass",
      "day",
      "drop-in",
      "visitor",
      "one day"
    ],
    "title": "{{memberName}}",
    "subtitle": "Day pass · {{memberId}}",
    "status": "{{status}}",
    "search": [
      "memberName",
      "memberId"
    ]
  },
  "messaging": {
    "input": "message"
  },
  "scan": {
    "actions": [
      {
        "id": "enter",
        "label": "Let in",
        "kind": "check_in",
        "repeat": "always",
        "minRole": "door"
      }
    ],
    "lookup": {
      "input": "memberId"
    },
    "display": {
      "v": 1,
      "holder": "{{memberName}}",
      "header": {
        "chips": [
          {
            "id": "c_plan",
            "text": "Day pass",
            "tone": "teal",
            "icon": "clock"
          }
        ]
      },
      "panels": [
        {
          "id": "p_visits",
          "preset": {
            "id": "membership",
            "v": 1
          },
          "title": "Visits",
          "icon": "door-open",
          "on": [
            "ready",
            "ok"
          ],
          "rows": [
            {
              "id": "r_day",
              "type": "columns",
              "items": [
                {
                  "id": "i_first",
                  "label": "Today",
                  "value": {
                    "count": "{{history.visits.today}}",
                    "one": "# visit",
                    "other": "# visits",
                    "zero": "First visit"
                  }
                },
                {
                  "id": "i_last",
                  "label": "Last visit",
                  "value": "{{history.lastVisit.at|ago}}"
                }
              ]
            }
          ]
        }
      ],
      "notes": {
        "refused": "Ask at the front desk."
      },
      "customer": {
        "chips": [
          "c_plan"
        ],
        "panel": null
      }
    },
    "checkIn": {
      "mode": "unlimited",
      "days": 1,
      "durationFrom": "first_scan"
    },
    "access": {
      "input": {
        "plan": "plan"
      },
      "plans": [
        {
          "id": "day",
          "label": "Day pass",
          "kind": "always",
          "zones": [
            {
              "zone": "*"
            }
          ]
        }
      ],
      "suspend": {
        "input": "status",
        "equals": [
          "Suspended"
        ]
      },
      "rules": {
        "visitGapMinutes": 120,
        "reentryMinutes": null
      }
    }
  },
  "paper": {
    "schema": 1,
    "size": "a4",
    "barcode": "qr",
    "kind": "admission",
    "bring": "Photo ID if asked"
  }
}
