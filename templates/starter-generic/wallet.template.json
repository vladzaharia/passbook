{
  "schema": 1,
  "name": "Membership",
  "description": "Tier, term and status, with a renew link.",
  "wallets": {
    "schema": 1,
    "google": {
      "images": {
        "logo": "wallets/google/logo.png",
        "thumbnail": "wallets/google/thumbnail.png"
      }
    },
    "samsung": {}
  },
  "channels": {
    "paper": "off",
    "nfc": "off"
  },
  "blueprint": true,
  "inputs": {
    "type": "object",
    "required": [
      "holder",
      "memberId"
    ],
    "additionalProperties": false,
    "properties": {
      "holder": {
        "type": "string",
        "x-label": "Name",
        "x-group": "Holder",
        "x-order": 10,
        "minLength": 1,
        "maxLength": 80,
        "x-search": true
      },
      "memberId": {
        "type": "string",
        "x-label": "ID",
        "x-group": "Holder",
        "x-order": 20,
        "minLength": 1,
        "maxLength": 64,
        "x-search": true
      },
      "tier": {
        "type": "string",
        "x-label": "Tier",
        "x-group": "Holder",
        "x-order": 30,
        "enum": [
          "Standard",
          "Plus",
          "Pro"
        ],
        "default": "Standard",
        "x-widget": "select"
      },
      "since": {
        "type": "string",
        "x-label": "Since",
        "x-group": "Holder",
        "x-order": 50,
        "format": "date-time",
        "x-widget": "date"
      },
      "note": {
        "type": "string",
        "x-label": "Note",
        "x-group": "Message",
        "x-order": 60,
        "maxLength": 256,
        "x-widget": "textarea"
      },
      "website": {
        "type": "string",
        "x-label": "Website",
        "x-group": "Links",
        "x-order": 70,
        "format": "uri",
        "pattern": "^https://",
        "maxLength": 300,
        "x-widget": "url",
        "x-placeholder": "https://"
      },
      "wifiSsid": {
        "type": "string",
        "x-label": "Wi-Fi network",
        "x-group": "Wi-Fi",
        "x-order": 80,
        "maxLength": 32
      },
      "wifiPassword": {
        "type": "string",
        "x-label": "Wi-Fi password",
        "x-widget": "password",
        "x-group": "Wi-Fi",
        "x-order": 90,
        "maxLength": 63
      },
      "expirationDate": {
        "type": "string",
        "x-label": "Expires",
        "x-group": "Status",
        "x-order": 100,
        "format": "date-time",
        "x-widget": "datetime",
        "x-noneLabel": "Never expires"
      },
      "officeLat": {
        "type": "number",
        "minimum": -90,
        "maximum": 90,
        "x-label": "Office latitude",
        "x-group": "Location",
        "x-order": 200
      },
      "officeLng": {
        "type": "number",
        "minimum": -180,
        "maximum": 180,
        "x-label": "Office longitude",
        "x-group": "Location",
        "x-order": 201
      },
      "phone": {
        "type": "string",
        "pattern": "^\\+[0-9]{7,15}$",
        "x-pattern-message": "Enter a number with country code, like +14155550100.",
        "x-label": "Phone",
        "x-group": "Links",
        "x-order": 75,
        "maxLength": 16
      },
      "message": {
        "type": "string",
        "x-label": "Message",
        "x-group": "Message",
        "x-order": 59,
        "maxLength": 256,
        "x-widget": "textarea",
        "x-help": "Shown on the back."
      },
      "status": {
        "type": "string",
        "x-label": "Status",
        "x-group": "Membership",
        "x-order": 25,
        "enum": [
          "Active",
          "Frozen",
          "Past due",
          "Cancelled"
        ],
        "x-widget": "select",
        "default": "Active"
      },
      "guests": {
        "type": "integer",
        "minimum": 0,
        "maximum": 99,
        "x-label": "Guests left",
        "x-group": "Membership",
        "x-order": 26
      },
      "renewURL": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://",
        "maxLength": 300,
        "x-label": "Renew link",
        "x-group": "Links",
        "x-order": 35,
        "x-widget": "url",
        "x-placeholder": "https://"
      },
      "points": {
        "type": "integer",
        "minimum": 0,
        "default": 0,
        "x-label": "Points",
        "x-group": "Holder",
        "x-order": 40,
        "x-hidden": true
      }
    },
    "dependentRequired": {
      "wifiSsid": [
        "wifiPassword"
      ],
      "wifiPassword": [
        "wifiSsid"
      ],
      "officeLat": [
        "officeLng"
      ],
      "officeLng": [
        "officeLat"
      ]
    }
  },
  "sample": {
    "holder": "Alex Morgan",
    "memberId": "ID-0001",
    "tier": "Plus",
    "since": "2026-01-01T00:00:00Z",
    "wifiSsid": "Guest",
    "wifiPassword": "change-me",
    "status": "Active",
    "guests": 4,
    "points": 0
  },
  "bindings": [
    {
      "to": {
        "field": "holder"
      },
      "value": "{{holder}}"
    },
    {
      "to": {
        "field": "tier"
      },
      "value": "{{tier}}"
    },
    {
      "to": {
        "field": "status"
      },
      "value": "{{status}}"
    },
    {
      "to": {
        "field": "guests"
      },
      "value": "{{guests}}",
      "omitIfEmpty": true
    },
    {
      "to": {
        "field": "renew"
      },
      "value": "{{renewURL}}",
      "omitIfEmpty": true
    },
    {
      "to": {
        "field": "since"
      },
      "value": "{{since}}",
      "omitIfEmpty": true
    },
    {
      "to": {
        "field": "message"
      },
      "value": "{{message}}"
    },
    {
      "to": {
        "field": "note"
      },
      "value": "{{note}}",
      "remove": {
        "input": "note",
        "empty": true
      }
    },
    {
      "to": {
        "field": "site"
      },
      "value": "{{website}}",
      "omitIfEmpty": true
    },
    {
      "to": {
        "field": "site",
        "prop": "attributedValue"
      },
      "value": "<a href=\"{{website|html}}\">{{website|html}}</a>",
      "omitIfEmpty": true
    },
    {
      "to": {
        "barcode": "*",
        "prop": "message"
      },
      "value": "{{pass.scanCode}}"
    },
    {
      "to": {
        "barcode": "*",
        "prop": "altText"
      },
      "value": "{{memberId}}"
    },
    {
      "to": {
        "action": "portal",
        "prop": "url"
      },
      "value": "{{website}}",
      "omitIfEmpty": true
    },
    {
      "to": {
        "pointer": "/semantics/wifiAccess/0/ssid"
      },
      "value": "{{wifiSsid}}"
    },
    {
      "to": {
        "pointer": "/semantics/wifiAccess/0/password"
      },
      "value": "{{wifiPassword}}"
    },
    {
      "to": {
        "pointer": "/semantics"
      },
      "remove": {
        "input": "wifiSsid",
        "empty": true
      }
    },
    {
      "to": {
        "pointer": "/expirationDate"
      },
      "value": "{{expirationDate}}",
      "omitIfEmpty": true
    },
    {
      "to": {
        "pointer": "/locations/0/latitude"
      },
      "value": "{{officeLat}}"
    },
    {
      "to": {
        "pointer": "/locations/0/longitude"
      },
      "value": "{{officeLng}}"
    },
    {
      "to": {
        "pointer": "/locations"
      },
      "remove": {
        "any": [
          {
            "input": "officeLat",
            "empty": true
          },
          {
            "input": "officeLng",
            "empty": true
          }
        ]
      }
    },
    {
      "to": {
        "action": "support",
        "prop": "url"
      },
      "value": "tel:{{phone}}",
      "remove": {
        "input": "phone",
        "empty": true
      }
    },
    {
      "to": {
        "field": "phone"
      },
      "value": "{{phone}}",
      "omitIfEmpty": true
    },
    {
      "to": {
        "pointer": "/backgroundColor"
      },
      "value": "{{lookups.tier[tier].bg}}"
    },
    {
      "to": {
        "pointer": "/foregroundColor"
      },
      "value": "{{lookups.tier[tier].fg}}"
    },
    {
      "to": {
        "pointer": "/labelColor"
      },
      "value": "{{lookups.tier[tier].label}}"
    },
    {
      "to": {
        "pointer": "/voided"
      },
      "value": "{{lookups.void[status].void}}"
    }
  ],
  "display": {
    "icon": "id-card",
    "group": "membership-id",
    "aliases": [
      "member",
      "loyalty",
      "library",
      "student",
      "id"
    ],
    "title": "{{holder}}",
    "subtitle": "{{tier}}",
    "status": "{{status}}",
    "search": [
      "holder",
      "memberId"
    ]
  },
  "messaging": {
    "input": "message"
  },
  "scan": {
    "actions": [
      {
        "id": "check_in",
        "label": "Check in",
        "kind": "check_in",
        "repeat": "daily",
        "minRole": "door"
      },
      {
        "id": "guest_in",
        "label": "Guest in",
        "kind": "take",
        "input": "guests",
        "amount": {
          "max": 10,
          "presets": [
            1,
            2,
            3
          ]
        },
        "repeat": "always",
        "minRole": "door"
      }
    ],
    "lookup": {
      "input": "memberId"
    },
    "flags": [
      {
        "input": "status",
        "label": "Ask a manager",
        "equals": [
          "Frozen",
          "Past due",
          "Cancelled"
        ],
        "stop": true
      }
    ],
    "display": {
      "v": 1,
      "holder": "{{inputs.holder}}",
      "photo": {
        "minRole": "door"
      },
      "header": {},
      "panels": [
        {
          "id": "p_member",
          "preset": {
            "id": "details",
            "v": 1
          },
          "title": "Member",
          "icon": "id-card",
          "rows": [
            {
              "id": "r_field1",
              "slot": "field1",
              "type": "field",
              "label": "Tier",
              "value": "{{inputs.tier}}"
            },
            {
              "id": "r_field2",
              "slot": "field2",
              "type": "field",
              "label": "Guests left",
              "value": "{{inputs.guests}}"
            }
          ]
        }
      ],
      "notes": {
        "refused": "Ask at the front desk."
      }
    }
  },
  "lookups": {
    "tier": {
      "Standard": {
        "bg": "rgb(20,26,43)",
        "fg": "rgb(255,255,255)",
        "label": "rgb(94,234,212)"
      },
      "Plus": {
        "bg": "rgb(23,52,110)",
        "fg": "rgb(255,255,255)",
        "label": "rgb(147,197,253)"
      },
      "Pro": {
        "bg": "rgb(76,29,149)",
        "fg": "rgb(255,255,255)",
        "label": "rgb(253,224,71)"
      }
    },
    "void": {
      "Active": {
        "void": false
      },
      "Frozen": {
        "void": false
      },
      "Past due": {
        "void": false
      },
      "Cancelled": {
        "void": true
      }
    }
  },
  "paper": {
    "schema": 1,
    "size": "cr80",
    "barcode": "qr",
    "kind": "membership"
  }
}
