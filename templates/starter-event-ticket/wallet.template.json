{
  "schema": 1,
  "name": "PassBook · Event ticket",
  "description": "Event ticket with the poster layout and a classic fallback, relevant dates, venue semantics and an optional list of upcoming events.",
  "inputs": {
    "type": "object",
    "required": [
      "eventName",
      "venueName",
      "venueRegion",
      "startsAt",
      "endsAt",
      "attendee",
      "ticketId"
    ],
    "additionalProperties": false,
    "properties": {
      "eventName": {
        "type": "string",
        "x-label": "Event",
        "x-group": "Event",
        "x-order": 10,
        "minLength": 1,
        "maxLength": 80,
        "x-search": true
      },
      "venueName": {
        "type": "string",
        "x-label": "Venue",
        "x-group": "Event",
        "x-order": 20,
        "minLength": 1,
        "maxLength": 80
      },
      "venueRegion": {
        "type": "string",
        "x-label": "City",
        "x-group": "Event",
        "x-order": 30,
        "minLength": 1,
        "maxLength": 80
      },
      "venueRoom": {
        "type": "string",
        "x-label": "Room",
        "x-group": "Event",
        "x-order": 40,
        "minLength": 1,
        "maxLength": 60
      },
      "venueTimeZone": {
        "type": "string",
        "x-label": "Time zone",
        "x-group": "Event",
        "x-order": 45,
        "x-timeZone": true,
        "maxLength": 64
      },
      "startsAt": {
        "type": "string",
        "x-label": "Starts",
        "x-group": "Event",
        "x-order": 50,
        "format": "date-time",
        "x-widget": "datetime"
      },
      "endsAt": {
        "type": "string",
        "x-label": "Ends",
        "x-group": "Event",
        "x-order": 60,
        "format": "date-time",
        "x-widget": "datetime"
      },
      "venueLat": {
        "type": "number",
        "minimum": -90,
        "maximum": 90,
        "x-label": "Venue latitude",
        "x-group": "Event",
        "x-order": 70
      },
      "venueLng": {
        "type": "number",
        "minimum": -180,
        "maximum": 180,
        "x-label": "Venue longitude",
        "x-group": "Event",
        "x-order": 80
      },
      "attendee": {
        "type": "string",
        "x-label": "Attendee",
        "x-group": "Ticket",
        "x-order": 90,
        "minLength": 1,
        "maxLength": 80,
        "x-search": true
      },
      "admission": {
        "type": "string",
        "x-label": "Admission",
        "x-group": "Ticket",
        "x-order": 100,
        "maxLength": 40,
        "default": "General"
      },
      "seat": {
        "type": "string",
        "x-label": "Seat",
        "x-group": "Ticket",
        "x-order": 110,
        "maxLength": 40
      },
      "ticketId": {
        "type": "string",
        "x-label": "Ticket ID",
        "x-group": "Ticket",
        "x-order": 120,
        "minLength": 1,
        "maxLength": 64,
        "x-search": true
      },
      "note": {
        "type": "string",
        "x-label": "Note",
        "x-group": "Message",
        "x-order": 130,
        "maxLength": 256,
        "x-widget": "textarea"
      },
      "website": {
        "type": "string",
        "x-label": "Event page",
        "x-group": "Links",
        "x-order": 140,
        "format": "uri",
        "pattern": "^https://",
        "maxLength": 300,
        "x-widget": "url",
        "x-placeholder": "https://"
      },
      "directionsURL": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://",
        "maxLength": 300,
        "x-label": "Directions link",
        "x-group": "Links",
        "x-order": 150,
        "x-widget": "url"
      },
      "parkingURL": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://",
        "maxLength": 300,
        "x-label": "Parking link",
        "x-group": "Links",
        "x-order": 160,
        "x-widget": "url"
      },
      "doorsAt": {
        "type": "string",
        "x-label": "Doors",
        "x-group": "When",
        "x-order": 51,
        "format": "date-time",
        "x-widget": "datetime"
      },
      "upcomingEvents": {
        "type": "array",
        "maxItems": 10,
        "x-label": "Upcoming events",
        "x-group": "Upcoming events",
        "x-order": 170,
        "x-widget": "list",
        "x-itemLabel": "Event",
        "x-addLabel": "Add event",
        "x-help": "Season or series ticket. Wallet lists these on the pass. Past events drop off when the pass is next updated.",
        "items": {
          "type": "object",
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "x-label": "Name",
              "x-order": 10,
              "minLength": 1,
              "maxLength": 80
            },
            "startsAt": {
              "type": "string",
              "x-label": "Starts",
              "x-order": 20,
              "format": "date-time",
              "x-widget": "datetime"
            },
            "endsAt": {
              "type": "string",
              "x-label": "Ends",
              "x-order": 30,
              "format": "date-time",
              "x-widget": "datetime"
            },
            "venueName": {
              "type": "string",
              "x-label": "Venue",
              "x-order": 40,
              "maxLength": 80
            },
            "venueRegion": {
              "type": "string",
              "x-label": "City",
              "x-order": 50,
              "maxLength": 80
            },
            "note": {
              "type": "string",
              "x-label": "Note",
              "x-order": 60,
              "maxLength": 200
            },
            "website": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://",
              "maxLength": 300,
              "x-label": "Event page",
              "x-order": 70,
              "x-widget": "url"
            },
            "directionsURL": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://",
              "maxLength": 300,
              "x-label": "Directions link",
              "x-order": 80,
              "x-widget": "url"
            }
          }
        }
      }
    },
    "dependentRequired": {
      "venueLat": [
        "venueLng"
      ],
      "venueLng": [
        "venueLat"
      ]
    }
  },
  "sample": {
    "eventName": "Sample Event",
    "venueName": "Sample Hall",
    "venueRegion": "Cupertino, CA",
    "venueTimeZone": "America/Los_Angeles",
    "startsAt": "2030-06-01T19:00:00-07:00",
    "endsAt": "2030-06-01T22:00:00-07:00",
    "venueLat": 37.3349,
    "venueLng": -122.009,
    "attendee": "Alex Morgan",
    "ticketId": "TICKET-0001",
    "doorsAt": "2030-06-01T18:00:00-07:00",
    "venueRoom": "Main hall",
    "upcomingEvents": [
      {
        "name": "Sample Event",
        "startsAt": "2030-06-01T19:00:00-07:00",
        "endsAt": "2030-06-01T22:00:00-07:00",
        "venueName": "Sample Hall",
        "venueRegion": "Cupertino, CA"
      },
      {
        "name": "Sample Event: Encore",
        "startsAt": "2030-06-08T19:00:00-07:00",
        "endsAt": "2030-06-08T22:00:00-07:00",
        "venueName": "Sample Hall",
        "venueRegion": "Cupertino, CA",
        "note": "Doors at 6 PM."
      },
      {
        "name": "Sample Event: Finale",
        "startsAt": "2030-06-15T19:00:00-07:00",
        "venueName": "Harbor Arena",
        "venueRegion": "San Jose, CA"
      }
    ]
  },
  "bindings": [
    {
      "to": {
        "field": "event"
      },
      "value": "{{eventName}}"
    },
    {
      "to": {
        "field": "venue"
      },
      "value": "{{venueName}}"
    },
    {
      "to": {
        "field": "room"
      },
      "value": "{{venueRoom}}",
      "omitIfEmpty": true
    },
    {
      "to": {
        "field": "date"
      },
      "value": "{{startsAt}}"
    },
    {
      "to": {
        "field": "attendee"
      },
      "value": "{{attendee}}"
    },
    {
      "to": {
        "field": "admission"
      },
      "value": "{{admission}}",
      "omitIfEmpty": true
    },
    {
      "to": {
        "field": "seat"
      },
      "value": "{{seat}}",
      "omitIfEmpty": true
    },
    {
      "to": {
        "field": "note"
      },
      "value": "{{note}}",
      "remove": {
        "input": "note",
        "empty": true
      }
    },
    {
      "to": {
        "field": "site"
      },
      "value": "{{website}}",
      "omitIfEmpty": true
    },
    {
      "to": {
        "field": "site",
        "prop": "attributedValue"
      },
      "value": "<a href=\"{{website|html}}\">{{website|html}}</a>",
      "omitIfEmpty": true
    },
    {
      "to": {
        "barcode": "*",
        "prop": "message"
      },
      "value": "{{ticketId}}"
    },
    {
      "to": {
        "barcode": "*",
        "prop": "altText"
      },
      "value": "{{ticketId}}"
    },
    {
      "to": {
        "pointer": "/semantics/eventName"
      },
      "value": "{{eventName}}"
    },
    {
      "to": {
        "pointer": "/semantics/venueName"
      },
      "value": "{{venueName}}"
    },
    {
      "to": {
        "pointer": "/semantics/venueRegionName"
      },
      "value": "{{venueRegion}}"
    },
    {
      "to": {
        "pointer": "/semantics/venueRoom"
      },
      "value": "{{venueRoom}}",
      "omitIfEmpty": true
    },
    {
      "to": {
        "pointer": "/semantics/venueRoom"
      },
      "value": "{{venueName}}",
      "when": {
        "input": "venueRoom",
        "empty": true
      }
    },
    {
      "to": {
        "pointer": "/semantics/eventStartDate"
      },
      "value": "{{startsAt}}"
    },
    {
      "to": {
        "pointer": "/semantics/eventEndDate"
      },
      "value": "{{endsAt}}"
    },
    {
      "to": {
        "pointer": "/semantics/venueLocation/latitude"
      },
      "value": "{{venueLat}}"
    },
    {
      "to": {
        "pointer": "/semantics/venueLocation/longitude"
      },
      "value": "{{venueLng}}"
    },
    {
      "to": {
        "pointer": "/semantics/venueLocation"
      },
      "remove": {
        "any": [
          {
            "input": "venueLat",
            "empty": true
          },
          {
            "input": "venueLng",
            "empty": true
          }
        ]
      }
    },
    {
      "to": {
        "pointer": "/semantics/admissionLevel"
      },
      "value": "{{admission}}",
      "omitIfEmpty": true
    },
    {
      "to": {
        "pointer": "/semantics/attendeeName"
      },
      "value": "{{attendee}}"
    },
    {
      "to": {
        "pointer": "/expirationDate"
      },
      "value": "{{endsAt}}"
    },
    {
      "to": {
        "pointer": "/locations/0/latitude"
      },
      "value": "{{venueLat}}"
    },
    {
      "to": {
        "pointer": "/locations/0/longitude"
      },
      "value": "{{venueLng}}"
    },
    {
      "to": {
        "pointer": "/locations"
      },
      "remove": {
        "any": [
          {
            "input": "venueLat",
            "empty": true
          },
          {
            "input": "venueLng",
            "empty": true
          }
        ]
      }
    },
    {
      "to": {
        "pointer": "/directionsInformationURL"
      },
      "value": "{{directionsURL}}",
      "omitIfEmpty": true
    },
    {
      "to": {
        "pointer": "/parkingInformationURL"
      },
      "value": "{{parkingURL}}",
      "omitIfEmpty": true
    },
    {
      "to": {
        "field": "time"
      },
      "value": "{{startsAt}}"
    },
    {
      "to": {
        "field": "doors"
      },
      "value": "{{doorsAt}}",
      "omitIfEmpty": true
    }
  ],
  "display": {
    "title": "{{eventName}}",
    "subtitle": "{{attendee}}",
    "status": "{{venueName}}",
    "search": [
      "eventName",
      "attendee",
      "ticketId"
    ]
  },
  "behaviors": [
    {
      "use": "relevance-window",
      "version": 1,
      "config": {
        "start": "startsAt",
        "end": "endsAt",
        "leadMinutes": 120
      }
    },
    {
      "use": "upcoming-events",
      "version": 1,
      "config": {
        "input": "upcomingEvents",
        "timeZoneInput": "venueTimeZone"
      }
    }
  ]
}
