{
  "schema": 1,
  "name": "Coupon",
  "description": "A single-use offer with an expiry.",
  "wallets": {
    "schema": 1,
    "roles": {
      "finePrint": {
        "field": "fine"
      }
    },
    "google": {
      "classKey": "{{offer|url}}",
      "images": {
        "logo": "wallets/google/logo.png"
      }
    },
    "samsung": {
      "images": {
        "main": "wallets/samsung/main.png"
      }
    }
  },
  "channels": {
    "paper": "on",
    "nfc": "off"
  },
  "blueprint": true,
  "inputs": {
    "type": "object",
    "required": [
      "offer",
      "code",
      "expirationDate"
    ],
    "additionalProperties": false,
    "properties": {
      "offer": {
        "type": "string",
        "x-label": "Offer",
        "x-group": "Offer",
        "x-order": 10,
        "minLength": 1,
        "maxLength": 60,
        "x-search": true
      },
      "code": {
        "type": "string",
        "x-label": "Code",
        "x-group": "Offer",
        "x-order": 20,
        "minLength": 1,
        "maxLength": 64,
        "x-search": true
      },
      "validFor": {
        "type": "string",
        "x-label": "Valid for",
        "x-group": "Offer",
        "x-order": 30,
        "maxLength": 60,
        "default": "One purchase"
      },
      "note": {
        "type": "string",
        "x-label": "Note",
        "x-group": "Message",
        "x-order": 40,
        "maxLength": 256,
        "x-widget": "textarea"
      },
      "website": {
        "type": "string",
        "x-label": "Website",
        "x-group": "Links",
        "x-order": 50,
        "format": "uri",
        "pattern": "^https://",
        "maxLength": 300,
        "x-widget": "url",
        "x-placeholder": "https://"
      },
      "expirationDate": {
        "type": "string",
        "x-label": "Expires",
        "x-group": "Offer",
        "x-order": 60,
        "format": "date-time",
        "x-widget": "datetime"
      },
      "timeZone": {
        "type": "string",
        "x-label": "Time zone",
        "x-group": "Offer",
        "x-order": 61,
        "x-timeZone": true,
        "maxLength": 64
      },
      "storeLat": {
        "type": "number",
        "minimum": -90,
        "maximum": 90,
        "x-label": "Store latitude",
        "x-group": "Location",
        "x-order": 200
      },
      "storeLng": {
        "type": "number",
        "minimum": -180,
        "maximum": 180,
        "x-label": "Store longitude",
        "x-group": "Location",
        "x-order": 201
      },
      "message": {
        "type": "string",
        "x-label": "Message",
        "x-group": "Message",
        "x-order": 39,
        "maxLength": 256,
        "x-widget": "textarea",
        "x-help": "Shown on the back."
      }
    },
    "dependentRequired": {
      "storeLat": [
        "storeLng"
      ],
      "storeLng": [
        "storeLat"
      ]
    }
  },
  "sample": {
    "offer": "20% off",
    "code": "SAVE-0001",
    "validFor": "One purchase",
    "expirationDate": "2030-01-01T00:00:00Z"
  },
  "bindings": [
    {
      "to": {
        "field": "offer"
      },
      "value": "{{offer}}"
    },
    {
      "to": {
        "field": "terms"
      },
      "value": "{{validFor}}",
      "omitIfEmpty": true
    },
    {
      "to": {
        "field": "expires"
      },
      "value": "{{expirationDate}}"
    },
    {
      "to": {
        "field": "message"
      },
      "value": "{{message}}"
    },
    {
      "to": {
        "field": "note"
      },
      "value": "{{note}}",
      "remove": {
        "input": "note",
        "empty": true
      }
    },
    {
      "to": {
        "field": "site"
      },
      "value": "{{website}}",
      "omitIfEmpty": true
    },
    {
      "to": {
        "field": "site",
        "prop": "attributedValue"
      },
      "value": "<a href=\"{{website|html}}\">{{website|html}}</a>",
      "omitIfEmpty": true
    },
    {
      "to": {
        "barcode": "*",
        "prop": "message"
      },
      "value": "{{pass.scanCode}}"
    },
    {
      "to": {
        "barcode": "*",
        "prop": "altText"
      },
      "value": "{{code}}"
    },
    {
      "to": {
        "action": "offers",
        "prop": "url"
      },
      "value": "{{website}}",
      "omitIfEmpty": true
    },
    {
      "to": {
        "pointer": "/expirationDate"
      },
      "value": "{{expirationDate}}"
    },
    {
      "to": {
        "pointer": "/locations/0/latitude"
      },
      "value": "{{storeLat}}"
    },
    {
      "to": {
        "pointer": "/locations/0/longitude"
      },
      "value": "{{storeLng}}"
    },
    {
      "to": {
        "pointer": "/locations"
      },
      "remove": {
        "any": [
          {
            "input": "storeLat",
            "empty": true
          },
          {
            "input": "storeLng",
            "empty": true
          }
        ]
      }
    }
  ],
  "display": {
    "icon": "percent",
    "group": "save-spend",
    "aliases": [
      "voucher",
      "discount",
      "offer",
      "promo"
    ],
    "title": "{{offer}}",
    "subtitle": "{{code}}",
    "search": [
      "offer",
      "code"
    ]
  },
  "messaging": {
    "input": "message"
  },
  "scan": {
    "actions": [
      {
        "id": "redeem",
        "label": "Redeem",
        "kind": "use_up",
        "repeat": "once",
        "minRole": "door",
        "confirm": false
      }
    ],
    "lookup": {
      "input": "code"
    },
    "display": {
      "v": 1,
      "header": {
        "subtitle": "{{inputs.offer}}"
      },
      "panels": [
        {
          "id": "p_offer",
          "preset": {
            "id": "offer",
            "v": 1
          },
          "title": "Offer",
          "icon": "percent",
          "rows": [
            {
              "id": "r_offer",
              "slot": "offer",
              "type": "big",
              "value": "{{inputs.offer}}"
            },
            {
              "id": "r_terms",
              "slot": "terms",
              "type": "columns",
              "items": [
                {
                  "id": "i_when",
                  "label": "When",
                  "value": "{{inputs.validFor}}"
                },
                {
                  "id": "i_by",
                  "label": "Use by",
                  "value": "{{pass.validUntil|day}}"
                }
              ]
            }
          ]
        }
      ],
      "notes": {
        "refused": "One per customer."
      }
    }
  },
  "paper": {
    "schema": 1,
    "size": "half",
    "barcode": "code128",
    "kind": "coupon"
  }
}
