{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wallet",
  "main": "src/worker/index.ts",
  "account_id": "07a2eb0d4916b220da1f9c1387b5f6d8",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": true,
  // passbook.mobile is PUBLIC_BASE_URL; wallet.plrs.im only redirects there (REDIRECT_HOSTS).
  "routes": [
    { "pattern": "passbook.mobile", "custom_domain": true },
    { "pattern": "wallet.plrs.im", "custom_domain": true }
  ],

  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request runs the Worker first (host policy, routes, the SPA's pages from ASSETS)
    // except the files public/ ships, which the asset layer serves on every host.
    // tools/wrangler-config.test.ts keeps the exceptions in step with public/; vite.config.ts adds
    // Vite's own dev paths.
    "run_worker_first": [
      "/*",
      "!/index.html",
      "!/apple/*",
      "!/apple-touch-icon.png",
      "!/buddy-replay.js",
      "!/email/*",
      "!/favicon.ico",
      "!/favicon.svg",
      "!/fonts/*",
      "!/icons/*",
      "!/manifest.webmanifest",
      "!/og-image.png",
      "!/pass-tilt.js",
      "!/robots.txt",
      "!/templates/*",
      "!/theme-init.js"
    ]
  },

  "vars": {
    "PUBLIC_BASE_URL": "https://passbook.mobile",
    "REDIRECT_HOSTS": "wallet.plrs.im",
    "EMAIL_FROM": "delivery@passbook.mobile",
    "SUPPORT_EMAIL": "support@passbook.mobile",
    "OIDC_ISSUER": "https://id.plrs.im",
    "OIDC_CLIENT_ID": "https://passbook.mobile/auth/oidc/client-metadata.json",
    "OIDC_ADMIN_GROUP": "wallet-admins",
    "OIDC_USER_GROUP": "wallet-users",
    "PLATFORM_PASS_TYPE_ID": "pass.im.plrs.wallet",
    "PLATFORM_TEAM_ID": "48H7CLBV8Y",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFujM8ev6K0ns9wy",
    "SSRF_DENY_HOSTS": "plrs.im"
  },

  "secrets": {
    "required": [
      "KEK_V1",
      "TURNSTILE_SECRET",
      "SIGNER_PLATFORM_CERTIFICATE",
      "SIGNER_PLATFORM_PRIVATE_KEY",
      "BREAKGLASS_TOKEN_SHA256"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wallet-platform",
      // Placeholder until go-live (`wrangler d1 create wallet-platform`). Local dev and tests ignore it.
      "database_id": "f572193f-bb7e-4e05-96b5-b202c1e69bab",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "wallet-passes" }],

  "queues": {
    "producers": [
      { "binding": "JOBS", "queue": "wallet-jobs" },
      { "binding": "JOBS_DLQ", "queue": "wallet-jobs-dlq" }
    ],
    "consumers": [
      {
        "queue": "wallet-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 8,
        "retry_delay": 30,
        "dead_letter_queue": "wallet-jobs-dlq"
      },
      { "queue": "wallet-jobs-dlq", "max_batch_size": 10, "max_retries": 2 }
    ]
  },

  "workflows": [
    {
      "name": "wallet-template-import",
      "binding": "TEMPLATE_IMPORT",
      "class_name": "TemplateImport"
    },
    { "name": "wallet-bulk-reissue", "binding": "BULK_REISSUE", "class_name": "BulkReissue" },
    { "name": "wallet-broadcast", "binding": "BROADCAST", "class_name": "Broadcast" },
    {
      "name": "wallet-connection-sync",
      "binding": "CONNECTION_SYNC",
      "class_name": "ConnectionSync"
    }
  ],

  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["delivery@passbook.mobile"] }],

  // Enable at go-live after uploading the platform certificate. A missing binding means "push unavailable".
  // Retired Henry's id, do not reuse: 9d7b9372-b262-42c3-82db-e90c4c588e90

  "images": { "binding": "IMAGES" },

  "ratelimits": [
    { "name": "RL_LOGIN", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_MAGIC_LINK", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_PUBLIC", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
    {
      "name": "RL_PUBLIC_ASSET",
      "namespace_id": "1009",
      "simple": { "limit": 240, "period": 60 }
    },
    { "name": "RL_APPLE", "namespace_id": "1004", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_API_KEY", "namespace_id": "1005", "simple": { "limit": 600, "period": 60 } },
    { "name": "RL_WEBHOOK", "namespace_id": "1006", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_REFRESH", "namespace_id": "1007", "simple": { "limit": 3, "period": 60 } },
    { "name": "RL_APPLE_IP", "namespace_id": "1008", "simple": { "limit": 3000, "period": 60 } },
    { "name": "RL_SCAN_PAIR", "namespace_id": "1010", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_SCAN", "namespace_id": "1011", "simple": { "limit": 240, "period": 60 } },
    { "name": "RL_SCAN_LOOKUP", "namespace_id": "1012", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_SCAN_ORG", "namespace_id": "1013", "simple": { "limit": 3000, "period": 60 } }
  ],

  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "wallet_events" }],
  // Admin charts read wallet_events through this. Remote only; absent locally, charts fall back to D1.
  "analytics": { "binding": "ANALYTICS_SQL", "remote": true },
  "version_metadata": { "binding": "CF_VERSION" },

  "triggers": { "crons": ["* * * * *", "17 3 * * *"] },

  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "limits": {
    "cpu_ms": 10000
  },
  "mtls_certificates": [
    {
      "binding": "APNS",
      "certificate_id": "21997dae-c46c-4519-a54c-73c43dd5255c"
    }
  ]
}
