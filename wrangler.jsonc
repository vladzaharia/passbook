{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wallet",
  "main": "src/worker/index.ts",
  "account_id": "07a2eb0d4916b220da1f9c1387b5f6d8",
  "compatibility_date": "2026-08-14",
  // global_fetch_strictly_public: fetch() never reaches a private or same-account origin, so the DNS check in
  // safe-fetch (best effort: Workers cannot pin the resolved address) has a second line behind it.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": true,
  "durable_objects": { "bindings": [{ "name": "SCAN_HUB", "class_name": "ScanHub" }] },
  "exports": { "ScanHub": { "type": "durable-object", "storage": "sqlite" } },
  // passbook.mobile is PUBLIC_BASE_URL; wallet.plrs.im only redirects there (REDIRECT_HOSTS).
  "routes": [
    { "pattern": "passbook.mobile", "custom_domain": true },
    { "pattern": "wallet.plrs.im", "custom_domain": true },
    { "pattern": "developers.passbook.mobile", "custom_domain": true }
  ],

  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request runs the Worker first (host policy, routes, the SPA's pages from ASSETS)
    // except the files public/ ships, which the asset layer serves on every host. scan.webmanifest
    // runs the Worker too: SCAN_ENABLED gates it with /scan.
    // tools/wrangler-config.test.ts keeps the exceptions in step with public/; vite.config.ts adds
    // Vite's own dev paths.
    "run_worker_first": [
      "/*",
      "!/index.html",
      "!/apple/*",
      "!/apple-touch-icon.png",
      "!/buddy-replay.js",
      "!/email/*",
      "!/favicon.ico",
      "!/favicon.svg",
      "!/fonts/*",
      "!/icons/*",
      "!/join.js",
      "!/manifest.webmanifest",
      "!/og-image.png",
      "!/pass-tilt.js",
      "!/robots.txt",
      "!/templates/*",
      "!/theme-init.js",
      "!/zod-jitless.js"
    ]
  },

  "vars": {
    "PUBLIC_BASE_URL": "https://passbook.mobile",
    "REDIRECT_HOSTS": "wallet.plrs.im",
    // Answers 308 to /developers on PUBLIC_BASE_URL (custom domain above).
    "DEVELOPERS_HOSTS": "developers.passbook.mobile",
    "EMAIL_FROM": "delivery@passbook.mobile",
    "SUPPORT_EMAIL": "support@passbook.mobile",
    // Where the site's Request access form sends its mail (reply-to is the person who asked).
    "ACCESS_REQUEST_EMAIL": "support@passbook.mobile",
    "OIDC_ISSUER": "https://id.plrs.im",
    "OIDC_CLIENT_ID": "https://passbook.mobile/auth/oidc/client-metadata.json",
    // Pocket ID groups, matched by exact name. Platform admins: every org and the platform scope, developer implied.
    // Each OIDC_*_GROUP var takes one exact name or a comma list (the rename window; see docs/operations.md).
    "OIDC_PLATFORM_ADMIN_GROUP": "wallet_admins,passbook_platform_admins",
    // Comma list of Polaris ID subjects. When set, platform admin needs the group and a listed subject.
    "OIDC_PLATFORM_ADMIN_SUBJECTS": "",
    // May use the console; which orgs is decided by membership in PassBook.
    "OIDC_ADMIN_GROUP": "wallet_org_admins,passbook_console",
    "OIDC_DEVELOPER_GROUP": "passbook_developers",
    // "true": org console access also needs OIDC_ADMIN_GROUP (or platform admin). See docs/operations.md.
    "OIDC_CONSOLE_GROUP_REQUIRED": "false",
    "OIDC_USER_GROUP": "wallet_users,passbook_users",
    // The ID token's `amr` must contain this (a passkey). Empty turns the check off, for a mock provider.
    "OIDC_REQUIRE_AMR": "",
    "PLATFORM_PASS_TYPE_ID": "pass.im.plrs.wallet",
    "PLATFORM_TEAM_ID": "48H7CLBV8Y",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFujM8ev6K0ns9wy",
    "SSRF_DENY_HOSTS": "plrs.im",
    // "1" serves /scan, scan.webmanifest and the decoder worker. Off in production until M1.
    "SCAN_ENABLED": "1",
    // "1" stores the hardware summary devices report. On since the release after the tolerant
    // reader shipped. Rollback: set "0" and deploy; stored summaries are ignored by readers, not
    // dropped. Do not roll the Worker back past the tolerant reader (044cfe11d) while rows exist.
    "DEVICE_REPORT_HARDWARE": "1"
  },

  "secrets": {
    "required": [
      "TURNSTILE_SECRET",
      "SIGNER_PLATFORM_CERTIFICATE",
      "SIGNER_PLATFORM_PRIVATE_KEY",
      "BREAKGLASS_TOKEN_SHA256"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wallet-platform",
      // Placeholder until go-live (`wrangler d1 create wallet-platform`). Local dev and tests ignore it.
      "database_id": "f572193f-bb7e-4e05-96b5-b202c1e69bab",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "wallet-passes" }],

  "queues": {
    "producers": [
      { "binding": "JOBS", "queue": "wallet-jobs" },
      { "binding": "WEBHOOK_JOBS", "queue": "wallet-webhooks" },
      { "binding": "JOBS_DLQ", "queue": "wallet-jobs-dlq" }
    ],
    "consumers": [
      {
        "queue": "wallet-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 8,
        "retry_delay": 30,
        "dead_letter_queue": "wallet-jobs-dlq"
      },
      // Tenant receivers can be slow: their own queue and small batches keep push and email from waiting behind them.
      {
        "queue": "wallet-webhooks",
        "max_batch_size": 2,
        "max_batch_timeout": 2,
        "max_retries": 4,
        "retry_delay": 30,
        "dead_letter_queue": "wallet-jobs-dlq"
      },
      { "queue": "wallet-jobs-dlq", "max_batch_size": 10, "max_retries": 2 }
    ]
  },

  "workflows": [
    {
      "name": "wallet-template-import",
      "binding": "TEMPLATE_IMPORT",
      "class_name": "TemplateImport"
    },
    { "name": "wallet-bulk-reissue", "binding": "BULK_REISSUE", "class_name": "BulkReissue" },
    { "name": "wallet-broadcast", "binding": "BROADCAST", "class_name": "Broadcast" },
    { "name": "wallet-pass-import", "binding": "PASS_IMPORT", "class_name": "PassImport" },
    {
      "name": "wallet-identity-provision",
      "binding": "IDENTITY_PROVISION",
      "class_name": "IdentityProvision"
    },
    { "name": "wallet-channel-apply", "binding": "CHANNEL_APPLY", "class_name": "ChannelApply" },
    {
      "name": "wallet-connection-sync",
      "binding": "CONNECTION_SYNC",
      "class_name": "ConnectionSync"
    },
    { "name": "wallet-org-export", "binding": "ORG_EXPORT", "class_name": "OrgExport" },
    { "name": "wallet-org-purge", "binding": "ORG_PURGE", "class_name": "OrgPurge" }
  ],

  "services": [
    { "binding": "APPLE", "service": "apple-provisioner", "entrypoint": "AppleProvisioner" }
  ],

  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["delivery@passbook.mobile"] }],

  // Enable at go-live after uploading the platform certificate. A missing binding means "push unavailable".
  // Retired Henry's id, do not reuse: 9d7b9372-b262-42c3-82db-e90c4c588e90

  "images": { "binding": "IMAGES" },

  "ratelimits": [
    { "name": "RL_LOGIN", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_MAGIC_LINK", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_PUBLIC", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
    {
      "name": "RL_PUBLIC_ASSET",
      "namespace_id": "1009",
      "simple": { "limit": 240, "period": 60 }
    },
    { "name": "RL_APPLE", "namespace_id": "1004", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_API_KEY", "namespace_id": "1005", "simple": { "limit": 600, "period": 60 } },
    { "name": "RL_WEBHOOK", "namespace_id": "1006", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_REFRESH", "namespace_id": "1007", "simple": { "limit": 3, "period": 60 } },
    { "name": "RL_APPLE_IP", "namespace_id": "1008", "simple": { "limit": 3000, "period": 60 } },
    { "name": "RL_SCAN_PAIR", "namespace_id": "1010", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_SCAN", "namespace_id": "1011", "simple": { "limit": 240, "period": 60 } },
    { "name": "RL_SCAN_LOOKUP", "namespace_id": "1012", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_SCAN_ORG", "namespace_id": "1013", "simple": { "limit": 3000, "period": 60 } },
    // Customer-screen drafts (PUT /scan/draft) count apart from RL_SCAN: a burst of drafts never 429s a commit.
    { "name": "RL_SCAN_DRAFT", "namespace_id": "1026", "simple": { "limit": 300, "period": 60 } },
    {
      "name": "RL_GOOGLE_CALLBACK",
      "namespace_id": "1014",
      "simple": { "limit": 6000, "period": 60 }
    },
    // Outbound webhooks: POSTs per destination host (key host:<name>), across every org.
    { "name": "RL_WEBHOOK_HOST", "namespace_id": "1015", "simple": { "limit": 600, "period": 60 } },
    // Webhook sends per destination host and org (key host:<name>:<org>): one tenant's backlog cannot use the host's whole budget.
    {
      "name": "RL_WEBHOOK_HOST_ORG",
      "namespace_id": "1018",
      "simple": { "limit": 120, "period": 60 }
    },
    // Webhook test sends: 10 a minute per org and mode (key test:<org>:<mode>).
    { "name": "RL_WEBHOOK_OUT", "namespace_id": "1016", "simple": { "limit": 10, "period": 60 } },
    // Join link submits per link and IP.
    { "name": "RL_JOIN", "namespace_id": "1019", "simple": { "limit": 10, "period": 60 } },
    // API key tiers: RL_API_KEY is standard (600). Limits here must equal TIER_LIMITS in rate-limit.ts.
    {
      "name": "RL_API_KEY_HIGH",
      "namespace_id": "1020",
      "simple": { "limit": 3000, "period": 60 }
    },
    {
      "name": "RL_API_KEY_BULK",
      "namespace_id": "1021",
      "simple": { "limit": 12000, "period": 60 }
    },
    // Aggregate per org (key org:<id>) across all its keys; platform keys are exempt.
    { "name": "RL_API_ORG", "namespace_id": "1022", "simple": { "limit": 6000, "period": 60 } },
    // Developer try tokens: mint and use per person (key user:<id>).
    { "name": "RL_API_TRY", "namespace_id": "1023", "simple": { "limit": 60, "period": 60 } },
    // Workbench token reads of template file bytes (key session:<id>): immutable per hash, 10x the try budget.
    {
      "name": "RL_API_TRY_ASSET",
      "namespace_id": "1033",
      "simple": { "limit": 600, "period": 60 }
    },
    // Template upload and version save (dry runs included): keys user:<id> and org:<id>.
    {
      "name": "RL_TEMPLATE_UPLOAD",
      "namespace_id": "1024",
      "simple": { "limit": 60, "period": 60 }
    },
    // Signed-in browser calls per session (key session:<id>); API keys have their own tiers.
    { "name": "RL_SESSION", "namespace_id": "1025", "simple": { "limit": 1200, "period": 60 } },
    // Request access form: per network, and across all networks (the inbox is the shared resource).
    { "name": "RL_ACCESS", "namespace_id": "1027", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_ACCESS_ALL", "namespace_id": "1028", "simple": { "limit": 30, "period": 60 } },
    // Ledger writes for refused webhook deliveries (key: connection id): over budget the row is dropped, never the 401.
    {
      "name": "RL_WEBHOOK_LEDGER",
      "namespace_id": "1030",
      "simple": { "limit": 30, "period": 60 }
    },
    { "name": "RL_SIMULATE", "namespace_id": "1032", "simple": { "limit": 60, "period": 60 } },
    // Sandbox URL deliveries: 60 a minute per sandbox (key org:<id>), on top of the host limits.
    {
      "name": "RL_SANDBOX_DELIVERY",
      "namespace_id": "1031",
      "simple": { "limit": 60, "period": 60 }
    }
  ],

  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "wallet_events" }],
  // Admin charts read wallet_events through this. Remote only; absent locally, charts fall back to D1.
  "analytics": { "binding": "ANALYTICS_SQL", "remote": true },
  "version_metadata": { "binding": "CF_VERSION" },

  "triggers": { "crons": ["* * * * *", "17 3 * * *"] },

  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  // Workflows count every D1 call as a subrequest: 10,000 an instance by default. A 2,000-row import is about 110,000.
  "limits": {
    "cpu_ms": 10000,
    "subrequests": 500000
  },
  "mtls_certificates": [
    {
      "binding": "APNS",
      "certificate_id": "21997dae-c46c-4519-a54c-73c43dd5255c"
    }
  ]
}
