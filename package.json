{
  "name": "wallet",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/web/pass-card/sync-barcode.ts",
    "./src/web/pass-card/barcode-loader.ts"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node tools/build-templates.ts && node tools/dev-vars.ts && vite dev",
    "dev:vars": "node tools/dev-vars.ts",
    "build": "node tools/build-templates.ts && vite build && node tools/check-bundle.ts && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "gen": "node tools/build-templates.ts && node tools/build-ssr-tokens.ts && node tools/build-ssr-kit.ts && node tools/build-ssr-holder.ts && wrangler types --strict-vars=false",
    "format": "biome check --write .",
    "lint": "biome check .",
    "ci:lint": "biome ci --error-on-warnings .",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.web.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:worker": "vitest run --project worker",
    "test:web": "vitest run --project web",
    "coverage": "vitest run --project unit --project web --coverage --coverage.include='src/{passkit,shared,web}/**/*.{ts,tsx}' --coverage.reportsDirectory=coverage/node && vitest run --project worker --coverage --coverage.provider=istanbul --coverage.include='src/worker/**/*.{ts,tsx}' --coverage.reportsDirectory=coverage/worker",
    "test:e2e": "playwright test",
    "db:local": "wrangler d1 migrations apply wallet-platform --local",
    "breakglass": "node tools/breakglass.ts",
    "credentials": "node tools/credentials.ts",
    "identity:add": "node tools/identity-add.ts",
    "predeploy": "node tools/deploy.ts --check",
    "deploy": "node tools/deploy.ts",
    "check:rules": "node tools/check-log-codes.ts && node tools/check-sizes.ts && node tools/check-sql-owner.ts && knip",
    "check": "npm run gen && npm run ci:lint && npm run check:rules && npm run typecheck && npm run test && npm run build",
    "dev:oidc": "node test/mock-oidc/server.ts 5174"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@hono/zod-openapi": "1.6.3",
    "@polaris-key/brand": "0.10.0",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.22",
    "asn1js": "3.0.10",
    "bwip-js": "4.11.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "fflate": "0.8.3",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "lucide-react": "1.58.0",
    "pkijs": "3.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/vitest-plugin": "1.4.4",
    "@playwright/test": "1.64.1",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.48",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-istanbul": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "jsdom": "30.1.3",
    "jsonc-parser": "3.3.1",
    "knip": "6.41.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.12",
    "vitest-axe": "0.1.0",
    "wrangler": "4.151.1"
  },
  "overrides": {
    "@cloudflare/vitest-plugin": {
      "zod": "4.6.7"
    },
    "miniflare": {
      "undici": "7.30.1",
      "sharp": "0.35.5"
    }
  }
}
