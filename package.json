{
  "name": "wallet",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node tools/build-templates.ts && node tools/dev-vars.ts && vite dev",
    "dev:vars": "node tools/dev-vars.ts",
    "build": "node tools/build-templates.ts && vite build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "gen": "node tools/build-templates.ts && wrangler types --strict-vars=false",
    "gen:check": "npm run gen && git diff --exit-code -- src/generated worker-configuration.d.ts src/web/routeTree.gen.ts",
    "format": "biome format --write . && biome check --write .",
    "lint": "biome check .",
    "ci:lint": "biome ci .",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.web.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:worker": "vitest run --project worker",
    "test:web": "vitest run --project web",
    "test:e2e": "playwright test",
    "db:local": "wrangler d1 migrations apply wallet-platform --local",
    "credentials": "node tools/credentials.ts",
    "check": "npm run gen && npm run ci:lint && npm run typecheck && npm run test && npm run build",
    "dev:oidc": "node test/mock-oidc/server.ts 5174"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@hono/zod-openapi": "1.6.3",
    "@hookform/resolvers": "5.9.1",
    "@polaris-key/brand": "0.10.0",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toggle": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@radix-ui/react-visually-hidden": "1.2.13",
    "@tanstack/react-query": "5.104.3",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.21",
    "asn1js": "3.0.10",
    "bwip-js": "4.11.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "fflate": "0.8.3",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "lucide-react": "1.58.0",
    "pkijs": "3.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.47",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/bwip-js": "3.2.3",
    "@types/node": "24.19.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.12",
    "jsdom": "30.1.3",
    "jsonc-parser": "3.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.12",
    "vitest-axe": "0.1.0",
    "wrangler": "4.151.1"
  }
}
