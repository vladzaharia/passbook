{
  "custom": {
    "direction": "inbound",
    "recipe": "custom",
    "version": "2026-11-25",
    "checkedAt": "2026-11-25",
    "provider": {
      "name": "Your system",
      "consoleUrl": null,
      "docs": []
    },
    "secret": {
      "origin": "passbook",
      "allowPaste": true,
      "prefix": null,
      "minLength": 16,
      "whereStep": null
    },
    "subscriptions": {
      "perWebhook": "many",
      "topics": []
    },
    "steps": [
      {
        "id": "sign",
        "side": "provider",
        "title": "Sign each request",
        "parts": [
          {
            "t": "field",
            "label": "URL",
            "copy": "endpointUrl",
            "choose": false
          },
          {
            "t": "field",
            "label": "Signature header",
            "copy": "signatureHeader",
            "choose": false
          },
          {
            "t": "field",
            "label": "Timestamp header",
            "copy": "timestampHeader",
            "choose": false
          },
          {
            "t": "text",
            "text": "The timestamp is in seconds. Sign `{timestamp}.{raw body}` with HMAC-SHA256 and the secret, in hex. Send the signature as `v1=<hex>`."
          },
          {
            "t": "note",
            "text": "The time may be 5 minutes behind or 1 minute ahead."
          },
          {
            "t": "note",
            "text": "Send JSON of at most 256 KB and 100 records. Each record has a ref and the record."
          }
        ],
        "verified": true
      },
      {
        "id": "send",
        "side": "provider",
        "title": "Send a test",
        "parts": [
          {
            "t": "text",
            "text": "Set `PASSBOOK_SECRET` and `WEBHOOK_URL`, then run this."
          },
          {
            "t": "code",
            "lang": "curl",
            "code": "BODY='{\"id\":\"evt-1\",\"records\":[{\"ref\":\"m-001\",\"record\":{},\"deleted\":false}]}'\nTS=$(date +%s)\nSIG=$(printf '%s.%s' \"$TS\" \"$BODY\" | openssl dgst -sha256 -hmac \"$PASSBOOK_SECRET\" -hex | sed 's/^.* //')\ncurl -X POST \"$WEBHOOK_URL\" \\\n  -H 'content-type: application/json' \\\n  -H \"x-passbook-timestamp: $TS\" \\\n  -H \"x-passbook-signature: v1=$SIG\" \\\n  -d \"$BODY\""
          }
        ],
        "verified": true
      }
    ],
    "test": {
      "kind": "snippet",
      "text": "Send a signed record from your system. A valid one issues a pass.",
      "command": null,
      "issues": true
    },
    "troubleshooting": {
      "none": "Check the URL matches exactly and your system sent a request.",
      "signature_missing": "Send `x-passbook-signature` and `x-passbook-timestamp`.",
      "signature_mismatch": "Sign `{timestamp}.{raw body}` with the secret from the Secret step, whole, with no spaces.",
      "signature_expired": "The signed time is over 5 minutes off. Check the sending clock.",
      "payload": "Check the payload matches the shape you set in Setup.",
      "too_large": "Over 256 KB. Send fewer records per request.",
      "no_secret": "Save the secret first.",
      "unrecognized_shape": "Signed correctly, but the records are not where Setup says.",
      "no_ref": "Signed correctly, but a record has no id PassBook can use."
    }
  },
  "shopify-orders": {
    "direction": "inbound",
    "recipe": "shopify-orders",
    "version": "2026-11-25",
    "checkedAt": "2026-11-25",
    "provider": {
      "name": "Shopify",
      "consoleUrl": null,
      "docs": [
        {
          "label": "Shopify: webhooks",
          "url": "https://help.shopify.com/en/manual/orders/notifications/webhooks"
        },
        {
          "label": "Shopify: verify a webhook",
          "url": "https://shopify.dev/docs/apps/build/webhooks/subscribe/https"
        }
      ]
    },
    "secret": {
      "origin": "provider",
      "allowPaste": true,
      "prefix": null,
      "minLength": 16,
      "whereStep": "secret"
    },
    "subscriptions": {
      "perWebhook": "one",
      "topics": [
        {
          "id": "orders/create",
          "label": "Order creation",
          "required": true,
          "verified": true
        },
        {
          "id": "orders/updated",
          "label": null,
          "required": true,
          "verified": false
        },
        {
          "id": "orders/paid",
          "label": null,
          "required": false,
          "verified": false
        },
        {
          "id": "orders/cancelled",
          "label": null,
          "required": false,
          "verified": false
        },
        {
          "id": "orders/fulfilled",
          "label": null,
          "required": false,
          "verified": false
        }
      ]
    },
    "steps": [
      {
        "id": "connect",
        "side": "provider",
        "title": "Add the webhooks",
        "parts": [
          {
            "t": "path",
            "items": ["Settings", "Notifications", "Webhooks", "Create webhook"]
          },
          {
            "t": "text",
            "text": "Add one webhook for each event. Shopify takes one event per webhook."
          },
          {
            "t": "field",
            "label": "Event",
            "value": "One of the events below.",
            "choose": true
          },
          {
            "t": "field",
            "label": "Format",
            "value": "JSON",
            "choose": false
          },
          {
            "t": "field",
            "label": "URL",
            "copy": "endpointUrl",
            "choose": false
          },
          {
            "t": "field",
            "label": "Webhook API version",
            "value": "The latest stable one.",
            "choose": true
          },
          {
            "t": "topics"
          }
        ],
        "verified": true
      },
      {
        "id": "secret",
        "side": "provider",
        "title": "Copy the signing secret",
        "parts": [
          {
            "t": "text",
            "text": "Shopify signs every webhook made in admin with one secret for the store. It shows at the foot of the **Webhooks** page."
          },
          {
            "t": "note",
            "text": "Made by an app? Use that app's client secret."
          }
        ],
        "verified": false
      },
      {
        "id": "test",
        "side": "provider",
        "title": "Send a test",
        "parts": [
          {
            "t": "text",
            "text": "Open the row menu on the webhook and choose **Send test**."
          },
          {
            "t": "note",
            "text": "A test is a sample, so it may not issue a pass."
          }
        ],
        "verified": false
      }
    ],
    "test": {
      "kind": "button",
      "text": "Row menu, **Send test**. The sample may not be a real record, so no pass is issued.",
      "command": null,
      "issues": false
    },
    "troubleshooting": {
      "none": "Check the webhook is listed. Shopify deletes one that keeps failing.",
      "signature_missing": "Shopify sent no signature header. Make sure the webhook was created in Shopify admin.",
      "signature_mismatch": "The secret isn't the one signing these. Copy it again from the foot of the Webhooks page. Made by an app? Use that app's client secret.",
      "payload": "The body was not JSON. Edit the webhook in Shopify and set **Format** to **JSON**.",
      "stale": "Signed correctly. It's a sample, so nothing was issued.",
      "unknown_type": "Shopify sent a topic this connection does not read. Remove it or ignore it.",
      "unrecognized_shape": "Signed correctly, but it isn't an order. Check the topic."
    }
  },
