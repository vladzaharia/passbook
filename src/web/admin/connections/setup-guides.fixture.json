  "stripe-subscriptions": {
    "direction": "inbound",
    "recipe": "stripe-subscriptions",
    "version": "2026-11-25",
    "checkedAt": "2026-11-25",
    "provider": {
      "name": "Stripe",
      "consoleUrl": "https://dashboard.stripe.com/webhooks",
      "docs": [
        {
          "label": "Stripe: webhooks",
          "url": "https://docs.stripe.com/webhooks"
        },
        {
          "label": "Stripe: Workbench",
          "url": "https://docs.stripe.com/workbench/overview"
        }
      ]
    },
    "secret": {
      "origin": "provider",
      "allowPaste": true,
      "prefix": "whsec_",
      "minLength": 16,
      "whereStep": "secret"
    },
    "subscriptions": {
      "perWebhook": "many",
      "topics": [
        {
          "id": "checkout.session.completed",
          "label": null,
          "required": true,
          "verified": true
        },
        {
          "id": "customer.subscription.updated",
          "label": null,
          "required": true,
          "verified": true
        },
        {
          "id": "customer.subscription.deleted",
          "label": null,
          "required": true,
          "verified": true
        }
      ]
    },
    "steps": [
      {
        "id": "connect",
        "side": "provider",
        "title": "Create the destination",
        "parts": [
          {
            "t": "path",
            "items": ["Dashboard", "Workbench", "Webhooks"]
          },
          {
            "t": "text",
            "text": "Choose **Create an event destination**."
          },
          {
            "t": "field",
            "label": "Events from",
            "value": "Your account",
            "choose": false
          },
          {
            "t": "field",
            "label": "Payload style",
            "value": "Snapshot",
            "choose": false
          },
          {
            "t": "warn",
            "text": "Not **Thin**. PassBook can't read a thin event, so nothing would be issued."
          },
          {
            "t": "field",
            "label": "API version",
            "value": "Your account's default.",
            "choose": true
          },
          {
            "t": "topics"
          },
          {
            "t": "field",
            "label": "Destination type",
            "value": "Webhook endpoint",
            "choose": false
          },
          {
            "t": "field",
            "label": "Endpoint URL",
            "copy": "endpointUrl",
            "choose": false
          },
          {
            "t": "text",
            "text": "Create the destination."
          }
        ],
        "verified": true
      },
      {
        "id": "secret",
        "side": "provider",
        "title": "Copy the signing secret",
        "parts": [
          {
            "t": "text",
            "text": "Open the destination. Under **Signing secret**, choose **Reveal** and copy `whsec_…`."
          },
          {
            "t": "note",
            "text": "Sandbox and live have different secrets."
          }
        ],
        "verified": true
      },
      {
        "id": "test",
        "side": "provider",
        "title": "Send a test",
        "parts": [
          {
            "t": "text",
            "text": "In a **sandbox**, make a destination with its own secret, then run the command in Stripe CLI or Workbench Shell."
          },
          {
            "t": "code",
            "lang": "sh",
            "code": "stripe trigger checkout.session.completed"
          },
          {
            "t": "note",
            "text": "Live: wait for a real checkout, or resend one from the destination."
          }
        ],
        "verified": true
      }
    ],
    "test": {
      "kind": "cli",
      "text": "Sandbox: run the command. Live: wait for a real checkout. A sandbox event passes the test, and issues a pass only when Test events is on.",
      "command": "stripe trigger checkout.session.completed",
      "issues": false
    },
    "troubleshooting": {
      "none": "Check the destination is in the same sandbox or live account you're testing in.",
      "signature_mismatch": "The secret isn't the one signing these. Copy it again from the destination, under **Signing secret**. Sandbox and live differ.",
      "signature_expired": "The signed time is over 5 minutes off. Check the sending clock.",
      "thin_event": "Stripe sent a thin event. Edit the destination and choose **Snapshot**.",
      "test_mode": "A sandbox event, signed correctly. Turn on Test events to issue from sandbox events.",
      "unknown_type": "Stripe sent an event this connection does not read. Remove it or ignore it.",
      "unrecognized_shape": "Signed correctly, but it isn't a subscription. Check the event."
    }
  },
