exports[`join page states > renders form 1`] = `"<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="color-scheme" content="light dark"><meta name="theme-color" content="#f6f8ff" media="(prefers-color-scheme: light)"><meta name="theme-color" content="#060912" media="(prefers-color-scheme: dark)"><meta name="format-detection" content="telephone=no"><link rel="icon" href="/favicon.ico" sizes="32x32"><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="apple-touch-icon" href="/apple-touch-icon.png"><meta name="robots" content="noindex, nofollow, noarchive"><meta name="referrer" content="strict-origin"><meta property="og:type" content="website"><meta property="og:title" content="Get your Dos Olas card"><title>Get your Dos Olas card</title><script src="/join.js" defer></script><script src="/buddy-replay.js" defer></script><style/></head><body><link rel="preload" as="image" imageSrcSet="/a/logo.png 1x, /a/logo@2x.png 2x, /a/logo@3x.png 3x"/><div class="jn"><header class="sticky top-0 z-20 border-b border-border bg-surface-page pt-[env(safe-area-inset-top)]"><div class="mx-auto flex h-[calc(3.5rem-1px)] w-full max-w-5xl items-center px-safe"><span class="min-w-0 truncate text-base font-semibold text-fg-strong">Dos Olas</span></div></header><main class="jn-main"><h1>Get your Dos Olas card</h1><div class="jn-grid"><div class="jn-host" data-art-host=""><span aria-hidden="true" data-buddy="" data-replay="" data-scene="beat" data-at="end" class="wl-buddy"><svg/></span><div class="jn-stage"><div class="pc-stage" data-face="front" data-tilt="true" data-enter="" data-single="" style="--pc-glow:color-mix(in srgb, rgb(200, 210, 230) 60%, rgb(30, 60, 120))"><div class="pc-lift"><div class="pc-flipper"><div class="pc-face" data-side="front"><div class="pc-root" data-face="front" data-style="generic" data-dark="true"><div class="pc-card" style="--pc-bg:rgb(30, 60, 120);--pc-fg:rgb(255, 255, 255);--pc-label:rgb(200, 210, 230)" role="group" aria-label="Example pass, front"><div class="pc-top"><div class="pc-logo"><img class="pc-logo-img" src="/a/logo.png" srcSet="/a/logo.png 1x, /a/logo@2x.png 2x, /a/logo@3x.png 3x" alt="" decoding="async" draggable="false"/><span class="pc-logo-text">Example</span></div><div class="pc-row pc-header"><div class="pc-field" data-fk="tier" data-align="right"><span class="pc-label">Tier</span><span class="pc-value"><span>Gold</span></span></div></div></div><div class="pc-main"><div class="pc-row pc-primary"><div class="pc-field" data-fk="name" data-align="natural" data-mid="true"><span class="pc-label">Member</span><span class="pc-value"><span>Ada Lovelace</span></span></div></div></div><div class="pc-row"><div class="pc-field" data-fk="since" data-align="natural" data-mid="true"><span class="pc-label">Since</span><span class="pc-value"><time dateTime="2024-03-01T00:00:00Z">Mar 1, 2024</time></span></div></div><div class="pc-row"><div class="pc-field" data-fk="points" data-align="natural"><span class="pc-label">Points</span><span class="pc-value"><span>12,500</span></span></div></div></div></div><span class="pc-shine" aria-hidden="true"></span><span class="pc-sheen" aria-hidden="true"></span></div></div></div></div></div></div><div class="jn-side"><form class="jn-form" data-join="" data-sitekey="1x00000000000000000000AA" action="" method="post"><div class="jn-field"><label for="name">First name</label><input id="name" type="text" autoComplete="given-name" required="" maxLength="80" autoCapitalize="words" spellCheck="false" name="name" value=""/></div><input type="hidden" name="cf-turnstile-response" value=""/><div class="jn-ts" data-ts=""></div><button class="btn" type="submit" data-submit="">Get my card</button></form></div></div></main></div></body></html>"`;

