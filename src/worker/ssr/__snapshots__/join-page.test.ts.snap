exports[`join page states > renders check email 1`] = `"<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="color-scheme" content="light dark"><meta name="theme-color" content="#f6f8ff" media="(prefers-color-scheme: light)"><meta name="theme-color" content="#060912" media="(prefers-color-scheme: dark)"><meta name="format-detection" content="telephone=no"><link rel="icon" href="/favicon.ico" sizes="32x32"><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="apple-touch-icon" href="/apple-touch-icon.png"><meta name="robots" content="noindex, nofollow"><meta name="description" content="Your Apple Wallet passes, ready to add."><link rel="manifest" href="/manifest.webmanifest"><meta name="apple-mobile-web-app-title" content="PassBook"><meta property="og:site_name" content="PassBook"><meta property="og:type" content="website"><meta property="og:title" content="Check your email"><meta property="og:description" content="Your Apple Wallet passes, ready to add."><title>Check your email · PassBook</title><style/></head><body><main class="hosted"><div class="band"><div class="brand"><a class="mark" href="/"><svg/><rect x="1" y="7" width="18" height="12" rx="3.5"></rect><circle cx="7" cy="12.5" r="1.5"></circle><circle data-wink="" cx="13" cy="12.5" r="1.5"></circle><path d="M8 15.25q2 1.5 4 0"></path></svg>PassBook</a></div><div class="scene" aria-hidden="true"><span data-replay="" data-scene="hello"><svg/></span></div></div><section class="card" data-state="confirm"><div class="body"><div><h1>Check your email</h1><p class="lede">We sent your Dos Olas card to ana@example.com.</p></div><p class="lede">Not there? Check spam. It can take a few minutes.</p><a class="btn outline" href="">Use a different email</a></div></section></main><script src="/buddy-replay.js" defer></script></body></html>"`;

