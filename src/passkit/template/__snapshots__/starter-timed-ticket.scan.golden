{
  "actions": [
    {
      "allowAgain": true,
      "allowOnConnected": false,
      "confirm": false,
      "id": "admit",
      "kind": "check_in",
      "label": "Admit",
      "minRole": "door",
      "notify": false,
      "repeat": "once"
    }
  ],
  "display": {
    "header": {},
    "holder": "{{inputs.name}}",
    "notes": {
      "refused": "Send them to the desk for the next slot."
    },
    "panels": [
      {
        "icon": "info",
        "id": "p_details",
        "preset": {
          "id": "details",
          "v": 1
        },
        "rows": [
          {
            "id": "r_field1",
            "label": "Adults",
            "slot": "field1",
            "type": "field",
            "value": "{{inputs.adults}}"
          },
          {
            "id": "r_field2",
            "label": "Children",
            "slot": "field2",
            "type": "field",
            "value": "{{inputs.children}}"
          },
          {
            "id": "r_field3",
            "label": "Entrance",
            "slot": "field3",
            "type": "field",
            "value": "{{inputs.entrance}}"
          }
        ],
        "title": "Details"
      }
    ],
    "v": 1
  },
  "lookup": {
    "input": "orderRef"
  },
  "window": {
    "earlyMinutes": 15,
    "from": "startsAt",
    "lateMinutes": 30,
    "until": "endsAt"
  }
}
