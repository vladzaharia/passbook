          },
          {
            "id": "r_field2",
            "label": "Pack",
            "slot": "field2",
            "type": "field",
            "value": "{{inputs.size}} {{inputs.unit}}"
          }
        ],
        "title": "Details"
      }
    ],
    "v": 1
  },
  "lookup": {
    "input": "packId"
